              name="practices"
              value="personnel_evidence"
            >

            <span>
              Personnel Evidence Review
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="pricing_review"
            >

            <span>
              Pricing Review
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="graphic_planning"
            >

            <span>
              Graphic Planning
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="blue_team"
            >

            <span>
              Blue Team Review
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="pink_team"
            >

            <span>
              Pink Team Review
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="red_team"
            >

            <span>
              Red Team Review
            </span>

          </label>


          <label class="sasha-practice-option">

            <input
              type="checkbox"
              name="practices"
              value="proofreading"
            >

            <span>
              Dedicated Proofreading
            </span>

          </label>

        </div>

      </section>

    {{/ifEquals}}


    {{!-- =================================================
         PLAN TASKS
    ================================================== --}}

    <section class="sasha-plan-section">

      <header class="sasha-plan-section-heading">

        <div>

          <p class="sasha-work-eyebrow">
            Pursuit execution
          </p>

          <h2>
            Plan Tasks
          </h2>

        </div>

        <p>
          Important planning decisions can become assigned pursuit
          tasks with clear owners and deadlines.
        </p>

      </header>


      {{#if planTasks.length}}

        <div class="sasha-plan-task-list">

          {{#each planTasks}}

            <article
              class="
                sasha-plan-task
                is-{{this.status}}
              "
            >

              <span class="sasha-plan-task-marker">

                {{#ifEquals this.status "complete"}}
                  ✓
                {{else}}
                  ○
                {{/ifEquals}}

              </span>


              <div class="sasha-plan-task-copy">

                <strong>
                  {{this.title}}
                </strong>

                <div class="sasha-plan-task-meta">

                  {{#if this.assignedTo}}

                    <span>
                      {{this.assignedTo}}
                    </span>

                  {{/if}}

                  {{#if this.dueDate}}

                    <span>
                      {{this.dueDate}}
                    </span>

                  {{/if}}

                </div>

              </div>

            </article>

          {{/each}}

        </div>

      {{else}}

        <div class="sasha-plan-tasks-empty">

          <p>
            No planning tasks have been created yet. Sasha can turn
            schedule milestones, assignments, evidence requests, and
            strategy actions into pursuit tasks as the plan develops.
          </p>

        </div>

      {{/if}}

    </section>


  </div>

</section>

<script>
document.addEventListener(
  'DOMContentLoaded',
  () => {

    const planForm =
      document.getElementById(
        'sasha-plan-chat-form'
      );

    const workingBlock =
      document.getElementById(
        'sasha-plan-working'
      );

    const workingVideo =
      document.getElementById(
        'sasha-plan-working-video'
      );


    if (
      !planForm ||
      !workingBlock ||
      !workingVideo
    ) {

      return;

    }


    planForm.addEventListener(
      'submit',
      () => {

        /* =============================================
           SHOW WORKING STATE
        ============================================= */

        workingBlock.hidden =
          false;

        workingBlock.setAttribute(
          'aria-hidden',
          'false'
        );


        /* =============================================
           START VIDEO FROM BEGINNING
        ============================================= */

        workingVideo.loop =
          false;

        workingVideo.currentTime =
          0;


        const playPromise =
          workingVideo.play();


        if (
          playPromise !==
          undefined
        ) {

          playPromise.catch(
            () => {

              /*
               * The form submission should continue
               * even if the browser refuses playback.
               */

            }
          );

        }


        /* =============================================
           BRING WORKING STATE INTO VIEW
        ============================================= */

        workingBlock.scrollIntoView({
          behavior:
            'smooth',

          block:
            'nearest'
        });

      }
    );

  }
);
</script>