{{!-- =================================================
     REVIEW FINDINGS
================================================== --}}

<section class="sasha-review-section">

  <header class="sasha-review-section-heading">

    <div>
      <p class="sasha-work-eyebrow">
        Findings
      </p>

      <h2>
        Review Findings
      </h2>
    </div>

    <p>
      Sasha organizes findings from the human review
      documents. Address each finding or skip it
      when no action is required.
    </p>

  </header>

  {{#if reviewFindings.length}}

    <div class="sasha-review-findings-list">

      {{#each reviewFindings}}

        <article
          class="sasha-review-finding is-{{this.status}}"
        >

          {{!-- FINDING STATUS --}}

          <div class="sasha-review-finding-marker">

            {{#ifEquals this.status "addressed"}}
              ✓
            {{else}}
              {{#ifEquals this.status "skipped"}}
                −
              {{else}}
                !
              {{/ifEquals}}
            {{/ifEquals}}

          </div>

          {{!-- FINDING CONTENT --}}

          <div class="sasha-review-finding-copy">

            <div class="sasha-review-finding-heading">

              <strong>
                {{this.title}}
              </strong>

              <span class="sasha-review-finding-source">
                {{this.reviewLabel}}
              </span>

            </div>

            {{#if this.description}}
              <p>
                {{this.description}}
              </p>
            {{/if}}

            {{#if this.recommendedAction}}

              <p>
                <strong>Recommended Action:</strong>
                {{this.recommendedAction}}
              </p>

            {{/if}}

            {{#if this.relatedSection}}

              <small>
                Section: {{this.relatedSection}}
              </small>

            {{/if}}

            {{#if this.sourceExcerpt}}

              <p class="sasha-review-finding-excerpt">
                <strong>Reviewer Comment:</strong>
                {{this.sourceExcerpt}}
              </p>

            {{/if}}

            {{!-- HUMAN DECISION --}}

            <div class="sasha-review-finding-decision">

              {{#ifEquals this.status "open"}}

                <form
                  action="/review/finding-decision"
                  method="POST"
                >

                  <input
                    type="hidden"
                    name="_csrf"
                    value="{{../csrfToken}}"
                  >

                  <input
                    type="hidden"
                    name="pursuitId"
                    value="{{../proposal._id}}"
                  >

                  <input
                    type="hidden"
                    name="reviewType"
                    value="{{this.reviewType}}"
                  >

                  <input
                    type="hidden"
                    name="findingId"
                    value="{{this._id}}"
                  >

                  <label for="finding-notes-{{this._id}}">
                    Resolution Notes (Optional)
                  </label>

                  <textarea
                    id="finding-notes-{{this._id}}"
                    name="resolutionNotes"
                    rows="2"
                    placeholder="Describe the action taken or explain why this finding can be skipped..."
                  ></textarea>

                  <div class="sasha-review-finding-actions">

                    <button
                      type="submit"
                      name="decision"
                      value="addressed"
                      class="sasha-color-review-action"
                    >
                      Addressed
                    </button>

                    <button
                      type="submit"
                      name="decision"
                      value="skipped"
                      class="sasha-color-review-action"
                    >
                      Skip
                    </button>

                  </div>

                </form>

              {{else}}

                <div class="sasha-review-finding-resolution">

                  <strong>
                    {{#ifEquals this.status "addressed"}}
                      Addressed
                    {{else}}
                      Skipped
                    {{/ifEquals}}
                  </strong>

                  {{#if this.resolutionNotes}}
                    <p>
                      {{this.resolutionNotes}}
                    </p>
                  {{/if}}

                  {{#if this.resolvedBy}}
                    <small>
                      Decision by: {{this.resolvedBy}}
                    </small>
                  {{/if}}

                  <form
                    action="/review/finding-decision"
                    method="POST"
                  >

                    <input
                      type="hidden"
                      name="_csrf"
                      value="{{../csrfToken}}"
                    >

                    <input
                      type="hidden"
                      name="pursuitId"
                      value="{{../proposal._id}}"
                    >

                    <input
                      type="hidden"
                      name="reviewType"
                      value="{{this.reviewType}}"
                    >

                    <input
                      type="hidden"
                      name="findingId"
                      value="{{this._id}}"
                    >

                    <input
                      type="hidden"
                      name="decision"
                      value="open"
                    >

                    <button
                      type="submit"
                      class="sasha-color-review-action"
                    >
                      Reopen
                    </button>

                  </form>

                </div>

              {{/ifEquals}}

            </div>

          </div>

        </article>

      {{/each}}

    </div>

  {{else}}

    <div class="sasha-review-findings-empty">

      <p>
        No review findings have been recorded yet.
        Upload Color Team review notes and ask Sasha
        to process them. Actionable findings will
        appear here.
      </p>

    </div>

  {{/if}}

</section>



