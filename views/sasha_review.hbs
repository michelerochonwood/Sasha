{{!-- =====================================================
     SASHA REVIEW
====================================================== --}}

<section
  class="sasha-work-page sasha-review-page"
  aria-labelledby="sasha-review-heading"
>

  <div class="sasha-work-container">


    {{!-- =================================================
         BACK TO PURSUIT
    ================================================== --}}

    <div class="sasha-work-back">

      <a href="/pursuit/{{proposal._id}}">
        ← Pursuit Dashboard
      </a>

    </div>


    {{!-- =================================================
         PAGE HEADER
    ================================================== --}}

    <header class="sasha-work-header">

      <div class="sasha-work-header-copy">

        <p class="sasha-work-eyebrow">
          Review
        </p>

        <h1 id="sasha-review-heading">
          {{proposal.proposalName}}
        </h1>

        {{#if proposal.clientName}}

          <p class="sasha-work-client">
            {{proposal.clientName}}
          </p>

        {{/if}}

        <p class="sasha-work-introduction">
          Review the proposal for compliance, competitive strength,
          consistency, readability, risk, and final quality.
          Sasha can review continuously or support structured team reviews.
        </p>

      </div>


      <div class="sasha-work-header-meta">

        {{#if proposal.rfpNumber}}

          <div class="sasha-work-meta-item">

            <span>
              RFP
            </span>

            <strong>
              {{proposal.rfpNumber}}
            </strong>

          </div>

        {{/if}}


        <div class="sasha-work-meta-item">

          <span>
            Status
          </span>

          <strong class="sasha-pursuit-capitalize">
            {{proposal.proposalStatus}}
          </strong>

        </div>


        <div class="sasha-work-meta-item">

          <span>
            Effort
          </span>

          <strong class="sasha-pursuit-capitalize">
            {{proposal.effortLevel}}
          </strong>

        </div>


        <div class="sasha-work-meta-item">

          <span>
            Sections
          </span>

          <strong>
            {{contentSections.length}}
          </strong>

        </div>

      </div>

    </header>


    {{!-- =================================================
         REVIEW MODE
    ================================================== --}}

    <section
      class="
        sasha-review-effort-banner
        is-{{proposal.effortLevel}}
      "
    >

      <div>

        <p class="sasha-work-eyebrow">
          Review Approach
        </p>


        {{#ifEquals proposal.effortLevel "minimal"}}

          <h2>
            Focused Final Review
          </h2>

          <p>
            Keep review effort controlled. Sasha will concentrate on
            mandatory requirements, submission readiness, obvious
            inconsistencies, proofreading, and avoiding disqualification.
          </p>

        {{/ifEquals}}


        {{#ifEquals proposal.effortLevel "usual"}}

          <h2>
            Focused Competitive Review
          </h2>

          <p>
            Sasha will review compliance, proposal responsiveness,
            strategy alignment, evidence, readability, and final quality.
            A focused independent review can be added where it provides
            useful competitive value.
          </p>

        {{/ifEquals}}


        {{#ifEquals proposal.effortLevel "full"}}

          <h2>
            Structured Competitive Review
          </h2>

          <p>
            This pursuit can use formal review checkpoints as well as
            Sasha's continuous review throughout proposal development.
          </p>

        {{/ifEquals}}

      </div>

    </section>


    {{!-- =================================================
         OPEN REVIEW FINDINGS SUMMARY
    ================================================== --}}

    <section class="sasha-review-section" aria-labelledby="sasha-review-open-heading">
      <div class="sasha-review-usual-option">
        <div>
          <p class="sasha-work-eyebrow">Open Findings</p>
          <h2 id="sasha-review-open-heading">Issues to Resolve</h2>
          <p>
            Review findings that still require a decision, revision,
            verification, or other action.
          </p>
        </div>
        <strong class="sasha-review-open-count">{{openReviewFindingCount}}</strong>
      </div>
    </section>


    {{!-- =================================================
         COLOR TEAM REVIEWS
         FULL EFFORT ONLY
    ================================================== --}}

    {{#ifEquals proposal.effortLevel "full"}}

      <section class="sasha-review-section">

        <header class="sasha-review-section-heading">

          <div>

            <p class="sasha-work-eyebrow">
              Structured Reviews
            </p>

            <h2>
              Color Team Reviews
            </h2>

          </div>

          <p>
            Review the right work at the right stage. Each review
            has a distinct purpose.
          </p>

        </header>


        <div class="sasha-color-review-grid">


          {{!-- =============================================
               BLUE TEAM
          ============================================== --}}

          <article
            class="
              sasha-color-review-card
              is-blue
            "
          >

            <div class="sasha-color-review-name">
              Blue Team
            </div>

            <h3>
              Test the Win Strategy
            </h3>

            <p>
              An impartial early review of the pursuit strategy before
              extensive proposal writing begins.
            </p>



<div class="sasha-color-review-status">

  <span>Human Review</span>

  <strong>
    {{#ifEquals reviews.blue.status "complete"}}
      Review Complete
    {{else}}
      {{#if reviews.blue.reviewNotes.length}}
        Review Notes Uploaded
      {{else}}
        Not Started
      {{/if}}
    {{/ifEquals}}
  </strong>

</div>

{{!-- ===============================================
     SASHA REVIEW PROCESSING
=============================================== --}}

{{#if reviews.blue.summarizedAt}}

  <div class="sasha-review-upload-confirmation">

    <p>
      <strong>Sasha's Review Summary</strong>
    </p>

    <p>
      {{reviews.blue.summary}}
    </p>

  </div>

{{/if}}


{{#if reviews.blue.reviewNotes.length}}

  <div class="sasha-review-upload-confirmation">

    <p>
      Review notes saved to this pursuit:
    </p>


<ul>
  {{#each reviews.blue.reviewNotes}}

    <li>
      <a
        href="/review/document/{{../proposal._id}}/blue/{{this._id}}"
        class="sasha-review-document-link"
        title="Download {{this.originalName}}"
      >
        {{this.originalName}}
      </a>
    </li>

  {{/each}}
</ul>


  </div>

{{/if}}



<a
  href="/plan/blue-team-review?pursuit={{proposal._id}}"
  class="sasha-color-review-action"
>
  Learn About Blue Team Review
</a>

<form
  action="/review/upload-notes"
  method="POST"
  enctype="multipart/form-data"
  class="sasha-review-upload-form"
>
  <input type="hidden" name="_csrf" value="{{csrfToken}}">
  <input type="hidden" name="pursuitId" value="{{proposal._id}}">
  <input type="hidden" name="reviewType" value="blue">

  <label for="blue-review-notes">
    Upload Blue Team Review Notes
  </label>

  <input
    type="file"
    id="blue-review-notes"
    name="reviewNotes"
    accept=".pdf,.docx,.txt"
    required
  >

  <button type="submit" class="sasha-color-review-action">
    Upload Review Notes
  </button>
</form>


{{#if reviews.blue.reviewNotes.length}}

  <form action="/review/summarize" method="POST">

    <input
      type="hidden"
      name="_csrf"
      value="{{csrfToken}}"
    >

    <input
      type="hidden"
      name="pursuitId"
      value="{{proposal._id}}"
    >

    <input
      type="hidden"
      name="reviewType"
      value="blue"
    >

    <button
      type="submit"
      class="sasha-color-review-action"
    >
      {{#if reviews.blue.summarizedAt}}
        Reprocess Review Findings
      {{else}}
        Process Review Findings
      {{/if}}
    </button>

  </form>

{{/if}}


{{!-- ===============================================
     BLUE TEAM | HUMAN REVIEW COMPLETION
=============================================== --}}

{{#if reviews.blue.summarizedAt}}

  {{#ifEquals reviews.blue.status "complete"}}

    <div class="sasha-review-upload-confirmation">

      <p>
        <strong>Human Review Complete</strong>
      </p>

      <p>
        The proposal team has confirmed that
        the Blue Team review is complete.
      </p>

      {{#if reviews.blue.completedBy}}
        <small>
          Confirmed by: {{reviews.blue.completedBy}}
        </small>
      {{/if}}

    </div>

  {{else}}

    <form
      action="/review/complete-human"
      method="POST"
      class="sasha-review-completion-form"
    >

      <input
        type="hidden"
        name="_csrf"
        value="{{csrfToken}}"
      >

      <input
        type="hidden"
        name="pursuitId"
        value="{{proposal._id}}"
