    {{/if}}

  {{/if}}

</article>

</section>


    {{!-- =================================================
         WORKFLOW
    ================================================== --}}

    <section class="sasha-pursuit-dashboard-section">

      <header class="sasha-pursuit-dashboard-section-heading">

        <div>

          <p class="sasha-pursuit-dashboard-eyebrow">
            pursuit progress
          </p>

          <h2>
            Where Things Stand
          </h2>

        </div>

        <p>
          Follow the pursuit from initial analysis through submission
          and outcome.
        </p>

      </header>


{{#if dashboard.workflowGroups.length}}

  <div class="sasha-pursuit-workflow-groups">

    {{#each dashboard.workflowGroups}}

      <section class="sasha-pursuit-workflow-group">

        <h3 class="sasha-pursuit-workflow-group-title">
          {{this.label}}
        </h3>

        <div class="sasha-pursuit-workflow">

          {{#each this.stages}}

      {{#if this.href}}

        <a
          href="{{this.href}}"
          class="
            sasha-pursuit-workflow-stage
            is-{{this.status}}
            is-link
          "
        >

          <span class="sasha-pursuit-workflow-marker">

            {{#ifEquals this.status "complete"}}
              ✓
            {{else}}
              {{#ifEquals this.status "in_progress"}}
                •
              {{else}}
                {{#ifEquals this.status "skipped"}}
                  —
                {{else}}
                  ○
                {{/ifEquals}}
              {{/ifEquals}}
            {{/ifEquals}}

          </span>

          <div>

            <strong>
              {{this.label}}
            </strong>

            <span>
              {{this.statusLabel}}
            </span>

          </div>

          <span
            class="sasha-pursuit-workflow-link-arrow"
            aria-hidden="true"
          >
            →
          </span>

        </a>

      {{else}}

        <div
          class="
            sasha-pursuit-workflow-stage
            is-{{this.status}}
          "
        >

          <span class="sasha-pursuit-workflow-marker">

            {{#ifEquals this.status "complete"}}
              ✓
            {{else}}
              {{#ifEquals this.status "in_progress"}}
                •
              {{else}}
                {{#ifEquals this.status "skipped"}}
                  —
                {{else}}
                  ○
                {{/ifEquals}}
              {{/ifEquals}}
            {{/ifEquals}}

          </span>

          <div>

            <strong>
              {{this.label}}
            </strong>

            <span>
              {{this.statusLabel}}
            </span>

          </div>

        </div>

      {{/if}}

          {{/each}}

        </div>

      </section>

    {{/each}}

  </div>

{{else}}

  <div class="sasha-pursuit-workflow-empty">

    <p>
      Sasha has not established the pursuit workflow yet.
      The stages will appear here as the pursuit develops.
    </p>

  </div>

{{/if}}


    {{!-- =================================================
         SASHA WORKSPACE
    ================================================== --}}

