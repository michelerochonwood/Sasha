        Completed on {{dashboard.winStrategyCompletedAt}}
      </span>

    {{else}}

      <span class="sasha-pursuit-deadline-remaining">
        Win strategy completed
      </span>

    {{/if}}


  {{else}}

    {{#if dashboard.internalCutoffs.winStrategy}}

      <strong>
        {{dashboard.internalCutoffs.winStrategy}}
      </strong>

      <span class="sasha-pursuit-deadline-remaining">
        Calculating time remaining...
      </span>

    {{else}}

      <strong class="is-empty">
        Not set
