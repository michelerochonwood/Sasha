{{!-- =====================================================
     PURSUIT DOCUMENT FILE STATUS
====================================================== --}}

<script>

  document.addEventListener(
    'DOMContentLoaded',
    () => {

      const fileInput =
        document.getElementById(
          'pursuitSourceDocuments'
        );

      const fileStatus =
        document.getElementById(
          'pursuitSourceDocumentsStatus'
        );


      if (
        !fileInput ||
        !fileStatus
      ) {

        return;

      }


      fileInput.addEventListener(
        'change',
        () => {

          const files =
            Array.from(
              fileInput.files ||
              []
            );


          if (
            files.length ===
            0
          ) {

            fileStatus.textContent =
              'PDF, DOCX, or TXT. Up to five files, 25 MB each.';

            return;

          }


          if (
            files.length ===
            1
          ) {

            fileStatus.textContent =
              files[0].name;

            return;

          }


          fileStatus.textContent =
            files
              .map(
                file =>
                  file.name
              )
              .join(', ');

        }
      );

    }
  );



  document.addEventListener(
    'DOMContentLoaded',
    () => {

      const deadlineCards =
        document.querySelectorAll(
          '.sasha-pursuit-deadline-card[data-internal-deadline]'
        );


      if (
        !deadlineCards.length
      ) {

        return;

      }


      const HOUR =
        60 * 60 * 1000;

      const DAY =
        24 * HOUR;


      /* =====================================================
         FORMAT REMAINING TIME
      ====================================================== */

      function formatRemainingTime(
        milliseconds
      ) {

        const totalHours =
          Math.max(
            0,
            Math.floor(
              milliseconds / HOUR
            )
          );


        const days =
          Math.floor(
            totalHours / 24
          );


        const hours =
          totalHours % 24;


        if (
          days > 0 &&
          hours > 0
        ) {

          return (
            `${days} ${days === 1 ? 'day' : 'days'}, ` +
            `${hours} ${hours === 1 ? 'hour' : 'hours'} remaining`
          );

        }


        if (
          days > 0
        ) {

          return (
            `${days} ${days === 1 ? 'day' : 'days'} remaining`
          );

        }


        if (
          hours > 0
        ) {

          return (
            `${hours} ${hours === 1 ? 'hour' : 'hours'} remaining`
          );

        }


        const minutes =
          Math.max(
            1,
            Math.floor(
              milliseconds /
              (60 * 1000)
            )
          );


        return (
          `${minutes} ${minutes === 1 ? 'minute' : 'minutes'} remaining`
        );

      }


      /* =====================================================
         UPDATE DEADLINE CARDS
      ====================================================== */

      function updateInternalDeadlineCards() {

        const now =
          new Date();


        deadlineCards.forEach(
          (card) => {

            const deadlineValue =
              card.dataset.internalDeadline;


            const deadline =
              new Date(
                deadlineValue
              );


            const remainingLabel =
              card.querySelector(
                '.sasha-pursuit-deadline-remaining'
              );


            if (
              Number.isNaN(
                deadline.getTime()
              )
            ) {

              return;

            }


            card.classList.remove(
              'is-deadline-green',
              'is-deadline-yellow',
              'is-deadline-red',
              'is-deadline-passed'
            );


            const remaining =
              deadline.getTime() -
              now.getTime();


            /* =============================================
               DEADLINE PASSED
            ============================================== */

            if (
              remaining <= 0
            ) {

              card.classList.add(
                'is-deadline-passed'
              );


              if (
                remainingLabel
              ) {

                remainingLabel.textContent =
                  'Consider not pursuing.';

              }


              return;

            }


            /* =============================================
               LESS THAN 1 DAY
            ============================================== */

            if (
              remaining < DAY
            ) {

              card.classList.add(
                'is-deadline-red'
              );

            }


            /* =============================================
               1 TO 3 DAYS
            ============================================== */

            else if (
              remaining <=
              (3 * DAY)
            ) {

              card.classList.add(
                'is-deadline-yellow'
              );

            }


            /* =============================================
               MORE THAN 3 DAYS
            ============================================== */

            else {

              card.classList.add(
                'is-deadline-green'
              );

            }


            if (
              remainingLabel
            ) {

              remainingLabel.textContent =
                formatRemainingTime(
                  remaining
                );

            }

          }
        );

      }


      updateInternalDeadlineCards();


      /*
       * Refresh once per minute so the dashboard can remain
       * open and still change state when a threshold is crossed.
       */

      window.setInterval(
        updateInternalDeadlineCards,
        60 * 1000
      );

    }
  );



</script>