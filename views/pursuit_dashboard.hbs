</article>


{{!-- =================================================
     WIN STRATEGY CUTOFF
================================================== --}}

<article
  class="
    sasha-pursuit-summary-card
    sasha-pursuit-deadline-card
    {{#if dashboard.winStrategyIsComplete}}
      is-complete
    {{/if}}
  "
  {{#unless dashboard.winStrategyIsComplete}}
    {{#if proposal.internalCutoffs.winStrategy}}
