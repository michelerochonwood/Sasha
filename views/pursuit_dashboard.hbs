{{!-- =====================================================
     PURSUIT DASHBOARD
====================================================== --}}

<section
  class="sasha-pursuit-dashboard"
  aria-labelledby="sasha-pursuit-dashboard-heading"
>

  <div class="sasha-pursuit-dashboard-container">


    {{!-- =================================================
         BACK TO PURSUITS
    ================================================== --}}

    <div class="sasha-pursuit-dashboard-back">

      <a href="/pursuits">
        ← All Pursuits
      </a>

    </div>

    {{!-- =================================================
     PAGE TITLE
================================================== --}}

<div class="sasha-pursuit-dashboard-page-title">

  <p>
    Pursuit
  </p>

  <h1>
    Pursuit Dashboard
  </h1>

</div>


    {{!-- =================================================
         PURSUIT HEADER
    ================================================== --}}

    <header class="sasha-pursuit-dashboard-header">

      <div class="sasha-pursuit-dashboard-identity">

        {{#if proposal.clientName}}

          <p class="sasha-pursuit-dashboard-client">
            {{proposal.clientName}}
          </p>

        {{/if}}


        <h2 id="sasha-pursuit-dashboard-heading">
          {{proposal.proposalName}}
        </h2>


        <div class="sasha-pursuit-dashboard-meta">

          {{#if proposal.rfpNumber}}

            <span>
              RFP {{proposal.rfpNumber}}
            </span>

          {{/if}}


          <span
            class="
              sasha-pursuit-dashboard-status
              sasha-pursuit-dashboard-status-{{proposal.proposalStatus}}
            "
          >
            {{proposal.proposalStatus}}
          </span>

        </div>

      </div>


      {{!-- ===============================================
           DEADLINE
      ================================================ --}}

      <div
        class="
          sasha-pursuit-dashboard-deadline
          {{#if dashboard.isOverdue}}
            is-overdue
          {{/if}}
        "
      >

        <span class="sasha-pursuit-dashboard-deadline-label">
          Submission
        </span>


        {{#if dashboard.timeRemaining}}

          <strong>
            {{dashboard.timeRemaining.label}}
          </strong>

          {{#if dashboard.isOverdue}}

            <span class="sasha-pursuit-dashboard-deadline-caption">
              Deadline passed
            </span>

          {{else}}

<span class="sasha-pursuit-dashboard-deadline-caption">
  left before the deadline
</span>

          {{/if}}

        {{else}}

          <strong>
            No deadline
          </strong>

          <span class="sasha-pursuit-dashboard-deadline-caption">
            Add the submission deadline
          </span>

        {{/if}}

      </div>

    </header>


{{!-- =================================================
     PURSUIT ACCOUNTABILITY + INTERNAL CUTOFFS
================================================== --}}

<section
  class="sasha-pursuit-dashboard-summary"
  aria-label="Pursuit accountability and internal cutoffs"
>


  {{!-- =================================================
       PROPOSAL MANAGER
  ================================================== --}}

  <article class="sasha-pursuit-summary-card">

    <span class="sasha-pursuit-summary-label">
      Proposal Manager
    </span>

    {{#if dashboard.proposalManager.name}}

      <strong>
        {{dashboard.proposalManager.name}}
      </strong>

      {{#if dashboard.proposalManager.email}}

        <span class="sasha-pursuit-summary-secondary">
          {{dashboard.proposalManager.email}}
        </span>

      {{/if}}

    {{else}}

      <strong class="is-empty">
        Not assigned
      </strong>

    {{/if}}

  </article>


{{!-- =================================================
     GO / NO GO CUTOFF
================================================== --}}

<article
  class="
    sasha-pursuit-summary-card
    sasha-pursuit-deadline-card
    {{#if dashboard.goNoGoIsComplete}}
      is-complete
    {{/if}}
  "
  {{#unless dashboard.goNoGoIsComplete}}
    {{#if proposal.internalCutoffs.goNoGo}}
      data-internal-deadline="{{proposal.internalCutoffs.goNoGo}}"
    {{/if}}
  {{/unless}}
>

  <span class="sasha-pursuit-summary-label">
    Go / No Go
  </span>


  {{#if dashboard.goNoGoIsComplete}}

    <strong>
      Completed
    </strong>

    {{#if dashboard.goNoGoCompletedAt}}

      <span class="sasha-pursuit-deadline-remaining">
        Completed on {{dashboard.goNoGoCompletedAt}}
      </span>

    {{else}}

      <span class="sasha-pursuit-deadline-remaining">
        Decision recorded
      </span>

    {{/if}}


  {{else}}

    {{#if dashboard.internalCutoffs.goNoGo}}

      <strong>
        {{dashboard.internalCutoffs.goNoGo}}
      </strong>

      <span class="sasha-pursuit-deadline-remaining">
        Calculating time remaining...
      </span>

    {{else}}

      <strong class="is-empty">
        Not set
      </strong>

    {{/if}}

  {{/if}}

</article>


{{!-- =================================================
     EFFORT LEVEL CUTOFF
================================================== --}}

<article
  class="
    sasha-pursuit-summary-card
    sasha-pursuit-deadline-card
    {{#if dashboard.effortLevelIsComplete}}
      is-complete
    {{/if}}
  "
  {{#unless dashboard.effortLevelIsComplete}}
    {{#if proposal.internalCutoffs.effortLevel}}
      data-internal-deadline="{{proposal.internalCutoffs.effortLevel}}"
    {{/if}}
  {{/unless}}
>

  <span class="sasha-pursuit-summary-label">
    Effort Level
  </span>


  {{#if dashboard.effortLevelIsComplete}}

    <strong>
      Completed
    </strong>

    {{#if dashboard.effortLevelCompletedAt}}

      <span class="sasha-pursuit-deadline-remaining">
        Completed on {{dashboard.effortLevelCompletedAt}}
      </span>

    {{else}}

      <span class="sasha-pursuit-deadline-remaining">
        Effort level recorded
      </span>

    {{/if}}


  {{else}}

    {{#if dashboard.internalCutoffs.effortLevel}}

      <strong>
        {{dashboard.internalCutoffs.effortLevel}}
      </strong>

      <span class="sasha-pursuit-deadline-remaining">
        Calculating time remaining...
      </span>

    {{else}}

      <strong class="is-empty">
        Not set
      </strong>

    {{/if}}

  {{/if}}

</article>


{{!-- =================================================
     OUTLINE CUTOFF
================================================== --}}

<article
  class="
    sasha-pursuit-summary-card
    sasha-pursuit-deadline-card
    {{#if dashboard.outlineIsComplete}}
      is-complete
    {{/if}}
  "
  {{#unless dashboard.outlineIsComplete}}
    {{#if proposal.internalCutoffs.outline}}
      data-internal-deadline="{{proposal.internalCutoffs.outline}}"
    {{/if}}
  {{/unless}}
>

  <span class="sasha-pursuit-summary-label">
    Outline
  </span>


  {{#if dashboard.outlineIsComplete}}

    <strong>
      Completed
    </strong>

    {{#if dashboard.outlineCompletedAt}}

      <span class="sasha-pursuit-deadline-remaining">
