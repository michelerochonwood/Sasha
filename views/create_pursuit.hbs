{{!-- =====================================================
     CREATE A PURSUIT
====================================================== --}}

<section class="sasha-create-pursuit-page">

  <div class="sasha-create-pursuit-container">


    {{!-- =================================================
         PAGE INTRODUCTION
    ================================================== --}}

    <header class="sasha-create-pursuit-header">

      <p class="sasha-create-pursuit-eyebrow">
        create a pursuit
      </p>

      <h1>
        Start a New Pursuit
      </h1>

      <p class="sasha-create-pursuit-intro">
        Give Sasha whatever information you have. Upload the RFP,
        procurement documents, notes, emails, or other pursuit material
        and Sasha will complete as much of the initial record as possible.
        Review her draft, make any changes, and save the pursuit when
        you are ready.
      </p>

    </header>


    {{!-- =================================================
         CREATE PURSUIT FORM
    ================================================== --}}

    <form
      class="sasha-create-pursuit-form"
      action="/create_pursuit"
      method="POST"
      enctype="multipart/form-data"
    >

      <input
        type="hidden"
        name="_csrf"
        value="{{csrfToken}}"
      >

      <input
        type="hidden"
        id="aiSummary"
        name="aiSummary"
        value=""
      >


      {{!-- =================================================
           SASHA AI IMPORT
      ================================================== --}}

      <section
        class="sasha-create-pursuit-import"
        aria-labelledby="sasha-create-pursuit-import-heading"
      >

        <div class="sasha-create-pursuit-import-header">

          <p class="sasha-create-pursuit-eyebrow">
            let Sasha get started
          </p>

          <h2 id="sasha-create-pursuit-import-heading">
            Give Sasha What You Have
          </h2>

          <p>
            You do not need to organize everything first. Upload the
            opportunity documents you already have and tell Sasha anything
            else she should know. She will review the material and prepare
            the first draft of the pursuit record.
          </p>

        </div>


        <div class="sasha-create-pursuit-import-grid">


          {{!-- PROMPT --}}

          <div class="sasha-create-pursuit-field">

            <label for="sashaPursuitPrompt">
              Tell Sasha anything that might help
            </label>

            <textarea
              id="sashaPursuitPrompt"
              name="sashaPursuitPrompt"
              rows="5"
              placeholder="For example: We received this RFP yesterday. The client is one of our existing municipal clients and we definitely want to pursue it. Please identify the submission deadline, RFP number, client, and opportunity name."
            ></textarea>

          </div>


          {{!-- SOURCE DOCUMENTS --}}

          <div class="sasha-create-pursuit-field">

            <label for="sourceDocuments">
              Upload pursuit documents

              <span class="sasha-create-pursuit-optional">
                optional
              </span>
            </label>

            <input
              type="file"
              id="sourceDocuments"
              name="sourceDocuments"
              accept=".pdf,.docx,.txt"
              multiple
            >

            <p class="sasha-create-pursuit-help">
              Upload the RFP, procurement notice, addenda, client
              correspondence, opportunity notes, scope documents, or
              other material related to the pursuit.
            </p>

          </div>


          {{!-- WHAT SASHA WILL DO --}}

          <div class="sasha-create-pursuit-import-note">

            <strong>
              What Sasha will do
            </strong>

            <ul>

              <li>
                Identify the pursuit name, client, RFP number,
                submission deadline, and other available information.
              </li>

              <li>
                Use your instructions to understand any context that
                may not appear in the source documents.
              </li>

              <li>
                Leave information blank when the source material does
                not support a reliable answer.
              </li>

              <li>
                Keep the uploaded documents with the pursuit so Sasha
                can use them throughout the proposal process.
              </li>

            </ul>

          </div>


          {{!-- AI ACTION --}}

          <div class="sasha-create-pursuit-import-actions">

            <button
              type="button"
              id="sashaPursuitImportButton"
              class="sasha-create-pursuit-primary-button"
            >
              Let Sasha Start the Form
            </button>

          </div>


          {{!-- SASHA WORKING --}}

          <div
            class="sasha-create-pursuit-loading"
            id="sashaPursuitImportLoading"
            hidden
            aria-live="polite"
          >

            <video
              class="sasha-create-pursuit-loading-video"
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              aria-hidden="true"
            >
              <source
                src="/images/sasha-working.mp4"
                type="video/mp4"
              >
            </video>

            <p>
              Sasha is reviewing the pursuit...
            </p>

          </div>


          <p
            id="sashaPursuitImportStatus"
            class="sasha-create-pursuit-import-status"
            aria-live="polite"
          ></p>

        </div>

      </section>


      {{!-- =================================================
           PURSUIT BASICS
      ================================================== --}}

      <details
        class="sasha-create-pursuit-section"
        open
      >

        <summary>
          Pursuit Basics
        </summary>

        <div class="sasha-create-pursuit-section-content">

          <p class="sasha-create-pursuit-section-intro">
            Review the basic information Sasha found and make any
            changes before creating the pursuit.
          </p>


          <div class="sasha-create-pursuit-grid sasha-create-pursuit-grid-two">


            {{!-- PROPOSAL NAME --}}

            <div
              class="
                sasha-create-pursuit-field
                sasha-create-pursuit-field-wide
              "
            >

              <label for="proposalName">
                Pursuit name

                <span
                  class="sasha-create-pursuit-required"
                  aria-hidden="true"
                >
                  *
                </span>
              </label>

              <input
                type="text"
                id="proposalName"
                name="proposalName"
                required
                maxlength="250"
                autocomplete="off"
              >

            </div>


            {{!-- CLIENT --}}

            <div class="sasha-create-pursuit-field">

              <label for="clientName">
                Client

                <span class="sasha-create-pursuit-optional">
                  optional
                </span>
              </label>

              <input
                type="text"
                id="clientName"
                name="clientName"
                maxlength="250"
                autocomplete="organization"
              >

            </div>


            {{!-- RFP NUMBER --}}

            <div class="sasha-create-pursuit-field">

              <label for="rfpNumber">
                RFP or procurement number

                <span class="sasha-create-pursuit-optional">
                  optional
                </span>
              </label>

              <input
                type="text"
                id="rfpNumber"
                name="rfpNumber"
                maxlength="150"
                autocomplete="off"
              >

            </div>


            {{!-- SUBMISSION DEADLINE --}}

            <div class="sasha-create-pursuit-field">

              <label for="submissionDeadline">
                Submission deadline

                <span
                  class="sasha-create-pursuit-required"
                  aria-hidden="true"
                >
                  *
                </span>
              </label>

              <input
                type="datetime-local"
                id="submissionDeadline"
                name="submissionDeadline"
                required
              >

            </div>


            {{!-- STATUS --}}

            <div class="sasha-create-pursuit-field">

              <label for="proposalStatus">
                Pursuit status
              </label>

              <select
                id="proposalStatus"
                name="proposalStatus"
              >

                <option
                  value="new"
                  selected
                >
                  New
                </option>

                <option value="planning">
                  Planning
                </option>

                <option value="writing">
                  Writing
                </option>

                <option value="review">
                  Review
                </option>

                <option value="submitted">
                  Submitted
                </option>

              </select>

            </div>

          </div>

        </div>

      </details>


      {{!-- =================================================
           PROPOSAL LEADERSHIP + INTERNAL CUTOFFS
      ================================================== --}}

      <details
        class="sasha-create-pursuit-section"
        open
      >

        <summary>
          Proposal Leadership &amp; Internal Cutoffs
        </summary>

        <div class="sasha-create-pursuit-section-content">


          <p class="sasha-create-pursuit-section-intro">
            A pursuit needs an owner. Opportunities can lose valuable time
            when everyone assumes someone else is taking the lead. Before
            creating this pursuit, identify the proposal manager who will
            be accountable for moving it forward.
          </p>


          {{!-- =================================================
               PROPOSAL MANAGER
          ================================================== --}}

          <div class="sasha-create-pursuit-grid sasha-create-pursuit-grid-two">


            <div class="sasha-create-pursuit-field">

              <label for="proposalManagerName">
                Proposal manager

                <span
                  class="sasha-create-pursuit-required"
                  aria-hidden="true"
                >
                  *
                </span>
              </label>

              <input
                type="text"
                id="proposalManagerName"
                name="proposalManagerName"
                required
                maxlength="200"
                autocomplete="name"
                placeholder="Name of the person responsible for this pursuit"
              >

              <p class="sasha-create-pursuit-help">
                Sasha will not choose the proposal manager. Someone needs
                to explicitly take responsibility for moving the pursuit
                forward.
              </p>

            </div>


            <div class="sasha-create-pursuit-field">

              <label for="proposalManagerEmail">
                Proposal manager email

                <span class="sasha-create-pursuit-optional">
                  optional
                </span>
              </label>

              <input
                type="email"
                id="proposalManagerEmail"
                name="proposalManagerEmail"
                maxlength="250"
                autocomplete="email"
                placeholder="name@company.com"
              >

              <p class="sasha-create-pursuit-help">
                Required only if you want Sasha to send milestone reminders.
              </p>

            </div>

          </div>


          {{!-- =================================================
               REMINDER PREFERENCE
          ================================================== --}}

          <fieldset class="sasha-create-pursuit-reminders">

            <legend>
              Milestone reminders
            </legend>


            <div class="sasha-create-pursuit-reminder-grid">


              <label class="sasha-create-pursuit-reminder-option">

                <input
                  type="radio"
                  name="milestoneReminderPreference"
                  value="dashboard"
                  checked
                >

                <span class="sasha-create-pursuit-reminder-control"></span>

                <span class="sasha-create-pursuit-reminder-copy">

                  <strong>
                    Dashboard only
                  </strong>

                  <small>
                    Sasha will show the cutoff status on the pursuit dashboard.
                  </small>

                </span>

              </label>


              <label class="sasha-create-pursuit-reminder-option">

                <input
                  type="radio"
                  name="milestoneReminderPreference"
                  value="email"
                >

                <span class="sasha-create-pursuit-reminder-control"></span>

                <span class="sasha-create-pursuit-reminder-copy">

                  <strong>
                    Email milestone reminders
                  </strong>

                  <small>
                    Sasha can also nudge the proposal manager as cutoffs
                    approach.
                  </small>

                </span>

              </label>

            </div>


            <p class="sasha-create-pursuit-help">
              You can change this preference later.
            </p>

          </fieldset>


          {{!-- =================================================
               SASHA RECOMMENDED CUTOFFS
          ================================================== --}}

          <section class="sasha-create-pursuit-cutoffs">

            <header class="sasha-create-pursuit-cutoff-header">

              <div>

                <p class="sasha-create-pursuit-cutoff-eyebrow">
                  Sasha's recommended cutoffs
                </p>

                <h3>
                  Protect enough time to finish the proposal properly
                </h3>

              </div>


              <button
                type="button"
                id="resetRecommendedCutoffs"
                class="sasha-create-pursuit-reset-button"
              >
                Reset to Sasha's recommendations
              </button>

            </header>


            <div class="sasha-create-pursuit-cutoff-explanation">

              <p>
                Sasha divides the time remaining before submission into
                five equal working periods. The first four establish
                internal cutoffs for key pursuit decisions.
              </p>

              <p>
                The final 20% is reserved for writing, review, production
                and submission. These are recommendations, not hard stops.
                If a cutoff is missed, Sasha may recommend reconsidering
                the pursuit, but the proposal manager always makes the
                final decision.
              </p>

            </div>


            <div class="sasha-create-pursuit-grid sasha-create-pursuit-grid-two">


              {{!-- GO / NO GO --}}

              <div class="sasha-create-pursuit-field">

                <label for="goNoGoCutoff">
                  Go / No Go cutoff

                  <span
                    class="sasha-create-pursuit-required"
                    aria-hidden="true"
                  >
                    *
                  </span>
                </label>

                <input
                  type="datetime-local"
                  id="goNoGoCutoff"
                  name="goNoGoCutoff"
                  required
                >

                <p class="sasha-create-pursuit-help">
                  Recommended at 20% of the time remaining.
                </p>

              </div>


              {{!-- EFFORT LEVEL --}}

              <div class="sasha-create-pursuit-field">

                <label for="effortLevelCutoff">
                  Effort level decided

                  <span
                    class="sasha-create-pursuit-required"
                    aria-hidden="true"
                  >
                    *
                  </span>
                </label>

                <input
                  type="datetime-local"
                  id="effortLevelCutoff"
                  name="effortLevelCutoff"
                  required
                >

                <p class="sasha-create-pursuit-help">
                  Recommended at 40% of the time remaining.
                </p>

              </div>


              {{!-- OUTLINE --}}

              <div class="sasha-create-pursuit-field">

                <label for="outlineCutoff">
                  Outline complete

                  <span
                    class="sasha-create-pursuit-required"
                    aria-hidden="true"
                  >
                    *
                  </span>
                </label>

                <input
                  type="datetime-local"
                  id="outlineCutoff"
                  name="outlineCutoff"
                  required
                >

                <p class="sasha-create-pursuit-help">
                  Recommended at 60% of the time remaining.
                </p>

              </div>


              {{!-- WIN STRATEGY --}}

              <div class="sasha-create-pursuit-field">

                <label for="winStrategyCutoff">
                  Win strategy complete

                  <span
                    class="sasha-create-pursuit-required"
                    aria-hidden="true"
                  >
                    *
                  </span>
                </label>

                <input
                  type="datetime-local"
                  id="winStrategyCutoff"
                  name="winStrategyCutoff"
                  required
                >

                <p class="sasha-create-pursuit-help">
                  Recommended at 80% of the time remaining.
                </p>

              </div>

            </div>


            <div class="sasha-create-pursuit-final-period">

              <strong>
                Final 20%
              </strong>

              <span>
                Reserved for writing, review, final production and
                submission.
              </span>

            </div>

          </section>

        </div>

      </details>


      {{!-- =================================================
           SEARCH INFORMATION
      ================================================== --}}

      <details class="sasha-create-pursuit-section">

        <summary>
          Search Information
        </summary>

        <div class="sasha-create-pursuit-section-content">

          <p class="sasha-create-pursuit-section-intro">
            Sasha can add useful search terms based on the opportunity.
            You can change or add to them if you wish.
          </p>


          <div class="sasha-create-pursuit-grid">

            <div class="sasha-create-pursuit-field">

              <label for="searchKeywords">
                Search keywords

                <span class="sasha-create-pursuit-optional">
                  optional
                </span>
              </label>

              <input
                type="text"
                id="searchKeywords"
                name="searchKeywords"
                placeholder="Water treatment, municipal, detailed design, contract administration..."
              >

              <p class="sasha-create-pursuit-help">
                Separate multiple keywords with commas.
              </p>

            </div>

          </div>

        </div>

      </details>


      {{!-- =================================================
           FORM ACTIONS
      ================================================== --}}

      <div class="sasha-create-pursuit-actions">

        <a
          class="sasha-create-pursuit-cancel-button"
          href="/pursuits"
        >
          Cancel
        </a>

        <button
          class="sasha-create-pursuit-primary-button"
          type="submit"
        >
          Create pursuit
        </button>

      </div>

    </form>

  </div>

</section>


{{!-- =====================================================
     CREATE PURSUIT SCRIPT
====================================================== --}}

<script>

  document.addEventListener(
    'DOMContentLoaded',
    () => {


      /* =====================================================
         AI IMPORT ELEMENTS
      ====================================================== */

      const importButton =
        document.getElementById(
          'sashaPursuitImportButton'
        );

      const promptInput =
        document.getElementById(
          'sashaPursuitPrompt'
        );

      const fileInput =
        document.getElementById(
          'sourceDocuments'
        );

      const status =
        document.getElementById(
          'sashaPursuitImportStatus'
        );

      const loading =
        document.getElementById(
          'sashaPursuitImportLoading'
        );

      const csrfInput =
        document.querySelector(
          'input[name="_csrf"]'
        );


      /* =====================================================
         CUTOFF ELEMENTS
      ====================================================== */

      const submissionDeadlineInput =
        document.getElementById(
          'submissionDeadline'
        );

      const goNoGoCutoffInput =
        document.getElementById(
          'goNoGoCutoff'
        );

      const effortLevelCutoffInput =
        document.getElementById(
          'effortLevelCutoff'
        );

      const outlineCutoffInput =
        document.getElementById(
          'outlineCutoff'
        );

      const winStrategyCutoffInput =
        document.getElementById(
          'winStrategyCutoff'
        );

      const resetRecommendedCutoffsButton =
        document.getElementById(
          'resetRecommendedCutoffs'
        );

      const proposalManagerEmailInput =
        document.getElementById(
          'proposalManagerEmail'
        );


      /* =====================================================
         FORMAT DATE FOR DATETIME-LOCAL
      ====================================================== */

      function formatDateTimeLocal(
        date
      ) {

        if (
          !date ||
          Number.isNaN(
            date.getTime()
          )
        ) {

          return '';

        }


        const pad =
          (value) =>
            String(value).padStart(
              2,
              '0'
            );


        return (
          date.getFullYear() +
          '-' +
          pad(
            date.getMonth() + 1
          ) +
          '-' +
          pad(
            date.getDate()
          ) +
          'T' +
          pad(
            date.getHours()
          ) +
          ':' +
          pad(
            date.getMinutes()
          )
        );

      }


      /* =====================================================
         CALCULATE RECOMMENDED CUTOFFS
      ====================================================== */

      function calculateRecommendedCutoffs() {

        if (
          !submissionDeadlineInput ||
          !submissionDeadlineInput.value
        ) {

          return;

        }


        const now =
          new Date();


        const deadline =
          new Date(
            submissionDeadlineInput.value
          );


        if (
          Number.isNaN(
            deadline.getTime()
          ) ||
          deadline <= now
        ) {

          return;

        }


        const remainingMilliseconds =
          deadline.getTime() -
          now.getTime();


        const calculateCutoff =
          (percentage) =>
            new Date(
              now.getTime() +
              (
                remainingMilliseconds *
                percentage
              )
            );


        if (goNoGoCutoffInput) {

          goNoGoCutoffInput.value =
            formatDateTimeLocal(
              calculateCutoff(
                0.20
              )
            );

        }


        if (effortLevelCutoffInput) {

          effortLevelCutoffInput.value =
            formatDateTimeLocal(
              calculateCutoff(
                0.40
              )
            );

        }


        if (outlineCutoffInput) {

          outlineCutoffInput.value =
            formatDateTimeLocal(
              calculateCutoff(
                0.60
              )
            );

        }


        if (winStrategyCutoffInput) {

          winStrategyCutoffInput.value =
            formatDateTimeLocal(
              calculateCutoff(
                0.80
              )
            );

        }

      }


if (
  submissionDeadlineInput
) {

  submissionDeadlineInput.addEventListener(
    'change',
    calculateRecommendedCutoffs
  );

  submissionDeadlineInput.addEventListener(
    'input',
    calculateRecommendedCutoffs
  );

}


      if (
        resetRecommendedCutoffsButton
      ) {

        resetRecommendedCutoffsButton.addEventListener(
          'click',
          calculateRecommendedCutoffs
        );

      }


      /* =====================================================
         EMAIL REMINDER REQUIREMENT
      ====================================================== */

      function updateReminderEmailRequirement() {

        const selectedPreference =
          document.querySelector(
            'input[name="milestoneReminderPreference"]:checked'
          );


        if (
          !proposalManagerEmailInput ||
          !selectedPreference
        ) {

          return;

        }


        proposalManagerEmailInput.required =
          selectedPreference.value ===
          'email';

      }


      document
        .querySelectorAll(
          'input[name="milestoneReminderPreference"]'
        )
        .forEach(
          (input) => {

            input.addEventListener(
              'change',
              updateReminderEmailRequirement
            );

          }
        );


      updateReminderEmailRequirement();

/* =====================================================
   INITIAL CUTOFF CALCULATION
===================================================== */

calculateRecommendedCutoffs();
      /* =====================================================
         STOP HERE IF AI IMPORT IS UNAVAILABLE
      ====================================================== */

      if (
        !importButton ||
        !promptInput ||
        !fileInput ||
        !status ||
        !loading
      ) {

        return;

      }

/* =====================================================
   NORMALIZE DATETIME-LOCAL VALUE
===================================================== */

function normalizeDateTimeLocalValue(
  value
) {

  if (!value) {
    return '';
  }


  const date =
    new Date(
      value
    );


  if (
    Number.isNaN(
      date.getTime()
    )
  ) {

    return '';

  }


  return formatDateTimeLocal(
    date
  );

}
      /* =====================================================
         SET ONE FORM FIELD
      ====================================================== */

      function setFieldValue(
        fieldId,
        value
      ) {

        if (
          value === null ||
          value === undefined ||
          value === ''
        ) {

          return;

        }


        const field =
          document.getElementById(
            fieldId
          );


        if (!field) {

          return;

        }


        if (
          Array.isArray(
            value
          )
        ) {

          field.value =
            value.join(
              ', '
            );

          return;

        }


        field.value =
          value;

      }


      /* =====================================================
         ANALYZE PURSUIT
      ====================================================== */

      importButton.addEventListener(
        'click',
        async () => {

          const files =
            Array.from(
              fileInput.files ||
              []
            );


          const prompt =
            promptInput.value.trim();


          if (
            files.length === 0 &&
            !prompt
          ) {

            status.textContent =
              'Upload a pursuit document or tell Sasha something about the opportunity first.';

            return;

          }


          const formData =
            new FormData();


          formData.append(
            'sashaPursuitPrompt',
            prompt
          );


          if (
            csrfInput &&
            csrfInput.value
          ) {

            formData.append(
              '_csrf',
              csrfInput.value
            );

          }


          files.forEach(
            (file) => {

              formData.append(
                'sourceDocuments',
                file
              );

            }
          );


          importButton.disabled =
            true;

          status.textContent =
            '';

          loading.hidden =
            false;


          try {

            const response =
              await fetch(
                '/create_pursuit/analyze',
                {
                  method:
                    'POST',

                  body:
                    formData
                }
              );


            const result =
              await response.json();


            if (
              !response.ok ||
              !result.success
            ) {

              throw new Error(
                result.errorMessage ||
                'Sasha could not review the pursuit material.'
              );

            }


            const suggestions =
              result.suggestions ||
              {};


            setFieldValue(
              'proposalName',
              suggestions.proposalName
            );


            setFieldValue(
              'clientName',
              suggestions.clientName
            );


            setFieldValue(
              'rfpNumber',
              suggestions.rfpNumber
            );


if (
  suggestions.submissionDeadline
) {

  setFieldValue(
    'submissionDeadline',
    normalizeDateTimeLocalValue(
      suggestions.submissionDeadline
    )
  );

  calculateRecommendedCutoffs();

}


            setFieldValue(
              'proposalStatus',
              suggestions.proposalStatus
            );


            setFieldValue(
              'searchKeywords',
              suggestions.searchKeywords
            );


            setFieldValue(
              'aiSummary',
              suggestions.aiSummary
            );


            status.textContent =
              'Sasha completed the information she could find. Review the draft below and make any changes before creating the pursuit.';


            const pursuitBasics =
              document.querySelector(
                '.sasha-create-pursuit-section'
              );


            if (
              pursuitBasics
            ) {

              pursuitBasics.open =
                true;

            }


            const proposalName =
              document.getElementById(
                'proposalName'
              );


            if (
              proposalName
            ) {

              proposalName.scrollIntoView(
                {
                  behavior:
                    'smooth',

                  block:
                    'center'
                }
              );

            }


          } catch (
            error
          ) {

            console.error(
              'PURSUIT ANALYSIS REQUEST FAILED:',
              error
            );


            status.textContent =
              error.message ||
              'Sasha could not review the pursuit material.';


          } finally {

            importButton.disabled =
              false;

            loading.hidden =
              true;

          }

        }
      );

    }
  );

</script>