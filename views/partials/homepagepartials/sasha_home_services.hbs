{{!-- =====================================================
SASHA HOMEPAGE SERVICES
====================================================== --}}

<h2
  id="sasha-home-services-heading"
  class="visually-hidden"
>
  Ask Sasha to help with pursuits and proposals
</h2>

<div class="sasha-home-services-list">

{{!-- =================================================
CREATE A PURSUIT
================================================== --}}

  <article class="sasha-home-service">

```
<a
  class="sasha-home-service-feature"
  href="/create_pursuit"
  aria-label="Create a pursuit"
>

  <h3>
    CREATE A PURSUIT
  </h3>

  <img
    src="/images/sasha_create_pursuit.png"
    alt=""
  >

</a>


<div class="sasha-home-service-prompt">

  <button
    class="sasha-home-service-prompt-button"
    type="button"
  >

    <span
      class="sasha-home-service-plus"
      aria-hidden="true"
    ></span>

    <span>
      ask Sasha to create a new pursuit from an RFP
      or opportunity
    </span>

  </button>

</div>
```

  </article>

