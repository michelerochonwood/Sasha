{{!-- =====================================================
     TEN STEPS TO A WIN THEME
===================================================== --}}

<main class="sasha-practice-page">

  <div class="sasha-container">

    {{!-- =================================================
         INTRODUCTION
    ================================================== --}}

    <section class="sasha-practice-page-hero">

      <p class="sasha-practice-page-eyebrow">
        WIN STRATEGY
      </p>

      <h1>
        Ten Steps to a Win Theme
      </h1>

      <p class="sasha-practice-page-intro">
        Build a persuasive win strategy by starting with the client,
        identifying what really matters about the project, and only then
        connecting your offer, evidence, and differentiation to those needs.
      </p>

    </section>


    {{!-- =================================================
         QUICK FACTS
    ================================================== --}}

    <section
      class="sasha-practice-page-section"
      aria-labelledby="ten-steps-quick-facts"
    >

      <h2 id="ten-steps-quick-facts">
        At a Glance
      </h2>

      <div class="sasha-practice-fact-grid">

        <article class="sasha-practice-fact-card">

          <p class="sasha-practice-fact-label">
            TIME
          </p>

          <p class="sasha-practice-fact-value">
            90 minutes
          </p>

          <p>
            Work through ten focused steps, allowing approximately
            nine minutes for each one.
          </p>

        </article>


        <article class="sasha-practice-fact-card">

          <p class="sasha-practice-fact-label">
            BEST FOR
          </p>

          <p class="sasha-practice-fact-value">
            Full Effort Pursuits
          </p>

          <p>
            This is most useful for competitive, strategically important
            pursuits where the team wants a deliberate and evidence-based
            reason for selection.
          </p>

        </article>


        <article class="sasha-practice-fact-card">

          <p class="sasha-practice-fact-label">
            OUTPUT
          </p>

          <p class="sasha-practice-fact-value">
            A working win strategy
          </p>

          <p>
            The session produces a structured argument connecting client
            issues, critical success factors, your response, evidence,
            differentiation, and client benefits.
          </p>

        </article>

      </div>

    </section>


    {{!-- =================================================
         WHO PARTICIPATES
    ================================================== --}}

    <section
      class="sasha-practice-page-section"
      aria-labelledby="ten-steps-participants"
    >

      <div class="sasha-practice-page-heading-row">

        <div>

          <p class="sasha-practice-page-kicker">
            WHO PARTICIPATES
          </p>

          <h2 id="ten-steps-participants">
            Bring the people who know the client, the project, and the work.
          </h2>

        </div>

      </div>


      <div class="sasha-practice-content-card">

        <p>
          The best session combines client knowledge, project insight,
          delivery experience, and proposal judgment. You do not need a
          huge group, but you do need people who can challenge assumptions
          and contribute real evidence.
        </p>


        <div class="sasha-practice-role-grid">

          <div class="sasha-practice-role">
            <strong>
              Pursuit Leader
            </strong>

            <span>
              Brings the business context, client relationship,
              positioning knowledge, and reasons for pursuing the work.
            </span>
          </div>


          <div class="sasha-practice-role">
            <strong>
              Proposed Project Manager
            </strong>

            <span>
              Brings delivery judgment, project understanding, and insight
              into what will make the assignment succeed.
            </span>
          </div>


          <div class="sasha-practice-role">
            <strong>
              Technical Leads
            </strong>

            <span>
              Help identify project issues, technical risks, critical
              success factors, and credible responses.
            </span>
          </div>


          <div class="sasha-practice-role">
            <strong>
              Proposal Manager
            </strong>

            <span>
              Facilitates the process, records the outputs, and keeps the
              discussion focused on the final proposal argument.
            </span>
          </div>


          <div class="sasha-practice-role">
            <strong>
              Client-Facing Staff
            </strong>

            <span>
              Contribute knowledge about client expectations, history,
              sensitivities, priorities, and evaluator concerns.
            </span>
          </div>


          <div class="sasha-practice-role">
            <strong>
              Specialists as Needed
            </strong>

            <span>
              Bring in pricing, technical, stakeholder, risk, or other
              expertise when it materially affects the strategy.
            </span>
          </div>

        </div>

      </div>

    </section>


    {{!-- =================================================
         STEPS
    ================================================== --}}

    <section
      class="sasha-practice-page-section"
      aria-labelledby="ten-steps-process"
    >

      <div class="sasha-practice-page-heading-row">

        <div>

          <p class="sasha-practice-page-kicker">
            THE PROCESS
          </p>

          <h2 id="ten-steps-process">
            Ten steps, in order
          </h2>

        </div>

      </div>


      <div class="sasha-practice-step-list">


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            01
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Understand the Client
            </h3>

            <p>
              Go beyond the RFP. Discuss what this client truly values in
              both the project and the working relationship.
            </p>

            <p>
              Consider how the client currently views your firm and whether
              your brand is merely qualified or genuinely credible for the
              opportunity.
            </p>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            02
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Understand the Project
            </h3>

            <p>
              Focus on the project itself. What makes it unique? What does
              the client hope will be true when the work is complete?
            </p>

            <p class="sasha-practice-step-note">
              Think about the project from conception through completion,
              not only the scope items listed in the RFP.
            </p>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            03
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Understand the Issues
            </h3>

            <p>
              Identify the technical, geographical, environmental,
              political, financial, operational, or stakeholder issues
              that could influence success.
            </p>

            <div class="sasha-practice-callout">

              <strong>
                Ask what could go wrong.
              </strong>

              <span>
                What is likely to worry the client or the evaluators most?
              </span>

            </div>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            04
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Identify the Critical Success Factors
            </h3>

            <p>
              Now flip the issues around. What must go right for the
              project to succeed?
            </p>

            <p>
              These success factors become the conditions your proposed
              approach must address.
            </p>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            05
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Clarify What You Don't Know
            </h3>

            <p>
              Identify the important gaps in your understanding.
              Determine what needs to be researched, confirmed, or asked
              of the client.
            </p>

            <p class="sasha-practice-step-note">
              Steps 1 through 5 deliberately focus on the client and
              project, not on your firm.
            </p>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            06
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Identify Features of Your Offer
            </h3>

            <p>
              Only now should the team turn inward. Identify the specific
              features of the proposed solution that address what you have
              learned.
            </p>

            <ul>
              <li>
                Methods
              </li>

              <li>
                Tools
              </li>

              <li>
                Processes
              </li>

              <li>
                Technologies
              </li>

              <li>
                Specialists
              </li>

              <li>
                Price or delivery approaches
              </li>
            </ul>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            07
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Identify the Value of Your Offer
            </h3>

            <p>
              Translate those features into meaningful client benefits.
              Ask what result each feature is expected to produce and why
              the client should care.
            </p>

            <div class="sasha-practice-callout">

              <strong>
                Keep asking: So what?
              </strong>

              <span>
                Continue until the feature connects to an outcome the
                client would actually value.
              </span>

            </div>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            08
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Present Evidence of Past Success
            </h3>

            <p>
              Find the projects, people, results, methods, and lessons
              that prove the team can deliver what it is proposing.
            </p>

            <p>
              The goal is not to list everything the firm has done.
              Select the evidence that is most relevant to the client and
              project issues identified earlier.
            </p>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            09
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Quantify the Evidence and Differentiate
            </h3>

            <p>
              Strengthen the evidence with meaningful comparisons:
              scale, stakeholders, schedule, complexity, outcomes, or
              other measurable characteristics.
            </p>

            <p>
              Then test the differentiation.
            </p>

            <div class="sasha-practice-callout">

              <strong>
                Could a credible competitor say the same thing?
              </strong>

              <span>
                If yes, the argument probably is not differentiated yet.
              </span>

            </div>

          </div>

        </article>


        <article class="sasha-practice-step-card">

          <div class="sasha-practice-step-number">
            10
          </div>

          <div class="sasha-practice-step-content">

            <h3>
              Shape the Argument Visually and Narratively
            </h3>

            <p>
              Decide how the win strategy will appear throughout the
              proposal using headings, callouts, captions, lists,
              graphics, evidence, and written messages.
            </p>

            <p>
              The same underlying argument should recur throughout the
              proposal without repeating the same sentence over and over.
            </p>

          </div>

        </article>


      </div>

    </section>


    {{!-- =================================================
         VALUE
    ================================================== --}}

    <section
      class="sasha-practice-page-section"
      aria-labelledby="ten-steps-value"
    >

      <div class="sasha-practice-value-panel">

        <div class="sasha-practice-value-heading">

          <p class="sasha-practice-page-kicker">
            WHY IT MATTERS
          </p>

          <h2 id="ten-steps-value">
            It stops the team from starting with itself.
          </h2>

        </div>


        <div class="sasha-practice-value-copy">

          <p>
            Proposal teams naturally begin by talking about their people,
            projects, technology, and qualifications. Ten Steps deliberately
            delays that conversation.
          </p>

          <p>
            The first half of the exercise forces the team to understand
            the client's world first: the client, the project, the issues,
            the success factors, and the unknowns.
          </p>

          <p>
            Only then does the team decide what it should offer and which
            evidence actually matters. The result is a proposal strategy
            built around the client's decision rather than a collection of
            familiar corporate messages.
          </p>

        </div>

      </div>

    </section>


    {{!-- =================================================
         WHAT YOU SHOULD HAVE AT THE END
    ================================================== --}}

    <section
      class="sasha-practice-page-section"
      aria-labelledby="ten-steps-output"
    >

      <div class="sasha-practice-content-card">

        <p class="sasha-practice-page-kicker">
          THE OUTPUT
        </p>

        <h2 id="ten-steps-output">
          At the end, the team should be able to answer these questions.
        </h2>


        <div class="sasha-practice-check-grid">

          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What matters most about this client?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What makes this project distinctive?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What are the most important issues?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What must go right for the project to succeed?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What will our team do about those issues?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What benefit does the client receive?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What evidence proves our approach is credible?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              Why is this offer particularly well suited to the opportunity?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What important questions remain unanswered?
            </span>
          </div>


          <div class="sasha-practice-check-item">
            <span class="sasha-practice-check">
              ✓
            </span>

            <span>
              What is the core argument for selecting our team?
            </span>
          </div>

        </div>

      </div>

    </section>


    {{!-- =================================================
     DECISION
================================================== --}}

<section
  class="sasha-practice-page-section
         sasha-practice-page-decision"
  aria-labelledby="ten-steps-decision"
>

  <div class="sasha-practice-decision-panel">

    <div>

      <p class="sasha-practice-page-kicker">
        ADD TO THIS PURSUIT?
      </p>

      <h2 id="ten-steps-decision">
        Would you like to use Ten Steps to a Win Theme?
      </h2>

      <p>
        Sasha will use this choice when creating the proposal
        schedule and will include this practice if you select Yes.
      </p>

    </div>


    <form
      method="POST"
      action="/plan/practice-decision"
      class="sasha-practice-decision-form"
    >

      {{#if csrfToken}}

        <input
          type="hidden"
          name="_csrf"
          value="{{csrfToken}}"
        >

      {{/if}}


      <input
        type="hidden"
        name="pursuitId"
        value="{{proposal._id}}"
      >


      <input
        type="hidden"
        name="practiceKey"
        value="ten-steps"
      >


      <fieldset class="sasha-practice-page-options">

        <legend class="visually-hidden">
          Use Ten Steps to a Win Theme
        </legend>


<label>

  <input
    type="radio"
    name="decision"
    value="yes"
    {{#if practiceSelected}}
      checked
    {{/if}}
  >

  <span>
    Yes
  </span>

</label>


<label>

  <input
    type="radio"
    name="decision"
    value="no"
    {{#unless practiceSelected}}
      checked
    {{/unless}}
  >

  <span>
    No
  </span>

</label>

      </fieldset>


      <button
        type="submit"
        class="sasha-plan-card-action"
      >
        Save Choice
      </button>

    </form>

  </div>

</section>
  </div>

</main>