<section class="sasha-work-page sasha-outcome-page">

  <div class="sasha-work-container sasha-outcome-container">


    {{!-- =====================================================
         BACK TO PURSUIT
    ====================================================== --}}

    <div class="sasha-work-back">
      <a href="/pursuit/{{pursuit._id}}">
        ← Back to Pursuit
      </a>
    </div>


    {{!-- =====================================================
         PAGE HEADER
    ====================================================== --}}

    <header class="sasha-work-header">

      <div class="sasha-work-header-copy">

        <p class="sasha-work-eyebrow">
          Results &amp; Debrief
        </p>

        <h1>
          {{pursuit.proposalName}}
        </h1>

        <p class="sasha-work-client">
          {{pursuit.clientName}}

          {{#if pursuit.rfpNumber}}
            | {{pursuit.rfpNumber}}
          {{/if}}
        </p>

        <p class="sasha-work-introduction">
          Capture the final result, client feedback,
          evaluation scores and lessons from this pursuit.
          Sasha can help organize debrief information and
          identify evidence-backed patterns to carry forward.
        </p>

      </div>


      <div class="sasha-work-header-meta">

        <div class="sasha-work-meta-item">
          <span>Outcome</span>

          <strong class="sasha-outcome-capitalize">
            {{#if pursuit.outcome.status}}
              {{pursuit.outcome.status}}
            {{else}}
              Pending
            {{/if}}
          </strong>
        </div>


        <div class="sasha-work-meta-item">
          <span>Decision Date</span>

          <strong>
            {{#if pursuit.outcome.decisionDate}}
              {{pursuit.outcome.decisionDate}}
            {{else}}
              Not recorded
            {{/if}}
          </strong>
        </div>


        <div class="sasha-work-meta-item">
          <span>Submission</span>

          <strong>
            {{#if pursuit.submissionDeadline}}
              {{pursuit.submissionDeadline}}
            {{else}}
              Not recorded
            {{/if}}
          </strong>
        </div>

      </div>

    </header>


    {{!-- =====================================================
         OUTCOME SUMMARY
    ====================================================== --}}

    <section
      class="
        sasha-outcome-summary
        sasha-outcome-summary-{{pursuit.outcome.status}}
      "
    >

      <div class="sasha-outcome-summary-result">

        <span class="sasha-outcome-summary-label">
          Proposal Outcome
        </span>

        <strong>
          {{#if pursuit.outcome.status}}
            {{pursuit.outcome.status}}
          {{else}}
            Pending
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Successful Proponent
        </span>

        <strong>
          {{#if pursuit.outcome.successfulProponent}}
            {{pursuit.outcome.successfulProponent}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Our Price
        </span>

        <strong>
          {{#if pursuit.outcome.ourPrice}}
            ${{pursuit.outcome.ourPrice}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Winning Price
        </span>

        <strong>
          {{#if pursuit.outcome.winningPrice}}
            ${{pursuit.outcome.winningPrice}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>

    </section>


    {{!-- =====================================================
         MAIN WORKSPACE
    ====================================================== --}}

    <div class="sasha-outcome-layout">


      {{!-- ===================================================
           MAIN COLUMN
      ==================================================== --}}

      <main class="sasha-outcome-main">


        {{!-- =================================================
             SASHA CHAT
        ================================================== --}}

        <section class="sasha-chat-panel">

          <header class="sasha-chat-header">

            <div>

              <p class="sasha-work-eyebrow">
                Debrief Assistant
              </p>

              <h2>
                Talk through the result with Sasha
              </h2>

            </div>

            <span class="sasha-chat-status">
              Outcome
            </span>

          </header>


          <div
            class="sasha-chat-thread sasha-outcome-chat-thread"
            id="outcomeChatThread"
          >

            {{#if pursuit.outcomeMessages.length}}

              {{#each pursuit.outcomeMessages}}

                <article
                  class="
                    sasha-chat-message
                    {{#if (eq role "user")}}
                      is-user
                    {{else}}
                      is-sasha
                    {{/if}}
                  "
                >

                  <div class="sasha-chat-speaker">

                    {{#if (eq role "user")}}
                      You
                    {{else}}
                      Sasha
                    {{/if}}

                  </div>

                  <div class="sasha-chat-bubble">
                    {{content}}
                  </div>

                </article>

              {{/each}}

            {{else}}

              <article class="sasha-chat-message is-sasha">

                <div class="sasha-chat-speaker">
                  Sasha
                </div>

                <div class="sasha-chat-bubble">
                  Tell me what happened with this pursuit.

                  You can paste client debrief notes,
                  evaluation scores, an award notice,
                  internal observations, or simply tell me
                  what you know.

                  I can help separate documented client
                  feedback from internal interpretation and
                  organize the useful findings for the
                  proposal record.
                </div>

              </article>

            {{/if}}

          </div>


          {{!-- =================================================
               SASHA WORKING VIDEO
          ================================================== --}}

          <div
            class="sasha-outcome-working"
            id="outcomeWorking"
            hidden
          >

            <video
              class="sasha-outcome-working-video"
              autoplay
              muted
              loop
              playsinline
            >
              <source
                src="/videos/sasha-working2.mp4"
                type="video/mp4"
              >
            </video>

            <p>
              Sasha is reviewing the outcome evidence...
            </p>

          </div>


          <div class="sasha-chat-composer">

            <label
              class="sasha-chat-label"
              for="outcomeMessage"
            >
              Message Sasha
            </label>

            <textarea
              id="outcomeMessage"
              name="message"
              placeholder="Paste debrief notes, scoring information, client feedback or tell Sasha what happened..."
            ></textarea>


            <div class="sasha-outcome-chat-upload">

              <label
                class="sasha-outcome-file-label"
                for="outcomeEvidenceFile"
              >
                Add debrief document
              </label>

              <input
                id="outcomeEvidenceFile"
                name="outcomeEvidenceFile"
                type="file"
              >

            </div>


            <div class="sasha-chat-actions">

              <p>
                Sasha will distinguish client evidence,
                evaluation data and internal observations
                before proposing updates to the outcome record.
              </p>

              <button
                class="sasha-chat-submit"
                type="button"
                id="sendOutcomeMessage"
              >
                Send to Sasha
              </button>

            </div>

          </div>

        </section>


        {{!-- =================================================
             EVALUATION RESULTS
        ================================================== --}}

        <details class="sasha-outcome-card sasha-outcome-details">

          <summary>
            Evaluation Results
          </summary>

          <div class="sasha-outcome-details-content">

            {{#if pursuit.outcome.evaluationResults.length}}

              <div class="sasha-outcome-evaluation-list">

                {{#each pursuit.outcome.evaluationResults}}

                  <article class="sasha-outcome-evaluation-item">

                    <strong>
                      {{criterion}}
                    </strong>

                    <div class="sasha-outcome-score-row">

                      <span>
                        Our score:
                        <strong>
                          {{ourScore}} / {{maxScore}}
                        </strong>
                      </span>

                      {{#if winningScore}}

                        <span>
                          Winner:
                          <strong>
                            {{winningScore}} / {{maxScore}}
                          </strong>
                        </span>

                      {{/if}}

                    </div>

                    {{#if comments}}

                      <p>
                        {{comments}}
                      </p>

                    {{/if}}

                  </article>

                {{/each}}

              </div>

            {{else}}

              <p class="sasha-outcome-empty">
                No evaluation scores have been recorded.
                Sasha can extract them from scoring sheets
                or debrief notes.
              </p>

            {{/if}}


            <button
              class="sasha-outcome-secondary-button"
              type="button"
              id="addEvaluationCriterion"
            >
              + Add Criterion
            </button>

          </div>

        </details>


        {{!-- =================================================
             KEY OUTCOME FACTORS
        ================================================== --}}

        <details
          class="sasha-outcome-card sasha-outcome-details"
          open
        >

          <summary>
            Key Outcome Factors
          </summary>

          <div class="sasha-outcome-details-content">

            {{#if pursuit.outcome.outcomeFactors.length}}

              <div class="sasha-outcome-factor-list">

                {{#each pursuit.outcome.outcomeFactors}}

                  <article
                    class="
                      sasha-outcome-factor
                      is-{{impact}}
                    "
                  >

                    <div class="sasha-outcome-factor-top">

                      <span class="sasha-outcome-factor-category">
                        {{category}}
                      </span>

                      <span
                        class="
                          sasha-outcome-factor-impact
                          is-{{impact}}
                        "
                      >
                        {{impact}}
                      </span>

                    </div>

                    <p>
                      {{summary}}
                    </p>

                    <small>
                      Source: {{sourceType}}

                      {{#if sourceDetail}}
                        — {{sourceDetail}}
                      {{/if}}
                    </small>

                  </article>

                {{/each}}

              </div>

            {{else}}

              <p class="sasha-outcome-empty">
                No outcome factors have been recorded yet.
                Give Sasha the debrief evidence and she can
                propose the factors that appear to have
                influenced the result.
              </p>

            {{/if}}

          </div>

        </details>


        {{!-- =================================================
             LESSONS FOR FUTURE PURSUITS
        ================================================== --}}

        <details
          class="sasha-outcome-card sasha-outcome-details"
          open
        >

          <summary>
            Lessons for Future Pursuits
          </summary>

          <div class="sasha-outcome-details-content">

            <div class="sasha-outcome-lessons">

              {{#if pursuit.outcome.lessons.length}}

                {{#each pursuit.outcome.lessons}}

                  <article class="sasha-outcome-lesson">

                    <div class="sasha-outcome-lesson-heading">

                      <strong>
                        {{title}}
                      </strong>

                      {{#if category}}

                        <span class="sasha-outcome-lesson-category">
                          {{category}}
                        </span>

                      {{/if}}

                    </div>

                    <p>
                      {{lesson}}
                    </p>


                    {{#if recommendation}}

                      <div class="sasha-outcome-recommendation">

                        <span>
                          Future Practice
                        </span>

                        <p>
                          {{recommendation}}
                        </p>

                      </div>

                    {{/if}}


                    {{#if evidenceBasis}}

                      <small>
                        Evidence basis: {{evidenceBasis}}
                      </small>

                    {{/if}}

                  </article>

                {{/each}}

              {{else}}

                <p class="sasha-outcome-empty">
                  No lessons have been recorded yet.
                  Sasha can help turn the outcome evidence into
                  practical lessons for future pursuits.
                </p>

              {{/if}}

            </div>


            <button
              class="sasha-outcome-secondary-button"
              type="button"
              id="addOutcomeLesson"
            >
              + Add Lesson
            </button>

          </div>

        </details>


        {{!-- =================================================
             INTERNAL OBSERVATIONS
        ================================================== --}}

        <details class="sasha-outcome-card sasha-outcome-details">

          <summary>
            Internal Observations
          </summary>

          <div class="sasha-outcome-details-content">

            <p class="sasha-outcome-guidance">
              Record observations from the pursuit team that may
              help explain the result. These are internal
              interpretations and should remain distinct from
              documented client feedback.
            </p>


            <div class="sasha-outcome-field">

              <label for="internalObservations">
                Pursuit Team Observations
              </label>

              <textarea
                id="internalObservations"
                name="internalObservations"
                placeholder="What did the pursuit team observe about the strategy, process, proposal, competition or client?"
              >{{pursuit.outcome.internalObservations}}</textarea>

            </div>

          </div>

        </details>


        {{!-- =================================================
             RECORD NOTES
        ================================================== --}}

        <details class="sasha-outcome-card sasha-outcome-details">

          <summary>
            Record Notes
          </summary>

          <div class="sasha-outcome-details-content">

            <div class="sasha-outcome-field">

              <label for="outcomeNotes">
                Additional Notes
              </label>

              <textarea
                id="outcomeNotes"
                name="outcomeNotes"
                placeholder="Add any other information that should remain with the permanent pursuit record."
              >{{pursuit.outcome.notes}}</textarea>

            </div>


            <button
              class="sasha-outcome-save-button"
              type="button"
              id="saveOutcomeDetails"
            >
              Save Outcome Details
            </button>

          </div>

        </details>

      </main>


      {{!-- ===================================================
           SIDEBAR
      ==================================================== --}}

      <aside class="sasha-outcome-sidebar">


        {{!-- =================================================
             RESULT
        ================================================== --}}

        <section class="sasha-outcome-card">

          <div class="sasha-outcome-card-heading">

            <p class="sasha-work-eyebrow">
              Result
            </p>

            <h2>
              Proposal Outcome
            </h2>

          </div>


          <div class="sasha-outcome-field">

            <label for="outcomeStatus">
              Outcome
            </label>

            <select
              id="outcomeStatus"
              name="status"
            >

              <option
                value="pending"
                {{#if (eq pursuit.outcome.status "pending")}}
                  selected
                {{/if}}
              >
                Pending
              </option>

              <option
                value="won"
                {{#if (eq pursuit.outcome.status "won")}}
                  selected
                {{/if}}
              >
                Won
              </option>

              <option
                value="lost"
                {{#if (eq pursuit.outcome.status "lost")}}
                  selected
                {{/if}}
              >
                Lost
              </option>

              <option
                value="withdrawn"
                {{#if (eq pursuit.outcome.status "withdrawn")}}
                  selected
                {{/if}}
              >
                Withdrawn
              </option>

              <option
                value="cancelled"
                {{#if (eq pursuit.outcome.status "cancelled")}}
                  selected
                {{/if}}
              >
                Cancelled
              </option>

              <option
                value="unknown"
                {{#if (eq pursuit.outcome.status "unknown")}}
                  selected
                {{/if}}
              >
                Unknown
              </option>

            </select>

          </div>


          <div class="sasha-outcome-field">

            <label for="decisionDate">
              Decision Date
            </label>

            <input
              id="decisionDate"
              name="decisionDate"
              type="date"
              value="{{pursuit.outcome.decisionDate}}"
            >

          </div>


          <div class="sasha-outcome-field">

            <label for="successfulProponent">
              Successful Proponent
            </label>

            <input
              id="successfulProponent"
              name="successfulProponent"
              type="text"
              value="{{pursuit.outcome.successfulProponent}}"
              placeholder="If known"
            >

          </div>


          <div class="sasha-outcome-field-grid">

            <div class="sasha-outcome-field">

              <label for="ourPrice">
                Our Price
              </label>

              <input
                id="ourPrice"
                name="ourPrice"
                type="number"
                step="0.01"
                value="{{pursuit.outcome.ourPrice}}"
              >

            </div>


            <div class="sasha-outcome-field">

              <label for="winningPrice">
                Winning Price
              </label>

              <input
                id="winningPrice"
                name="winningPrice"
                type="number"
                step="0.01"
                value="{{pursuit.outcome.winningPrice}}"
              >

            </div>

          </div>


          <button
            class="sasha-outcome-save-button"
            type="button"
            id="saveOutcomeResult"
          >
            Save Result
          </button>

        </section>


        {{!-- =================================================
             CLIENT DEBRIEF
        ================================================== --}}

        <section class="sasha-outcome-card">

          <div class="sasha-outcome-card-heading">

            <p class="sasha-work-eyebrow">
              Client Feedback
            </p>

            <h2>
              Client Debrief
            </h2>

          </div>


          <p class="sasha-outcome-guidance">
            Record feedback received directly from the client.
            Keep documented client comments separate from the
            pursuit team's own interpretation of the result.
          </p>


          <div class="sasha-outcome-field">

            <label for="clientDebrief">
              Client Feedback
            </label>

            <textarea
              id="clientDebrief"
              name="clientDebrief"
              placeholder="Paste or summarize the client's debrief comments here."
            >{{pursuit.outcome.clientDebrief}}</textarea>

          </div>


          <div class="sasha-outcome-field">

            <label for="debriefDate">
              Debrief Date
            </label>

            <input
              id="debriefDate"
              name="debriefDate"
              type="date"
              value="{{pursuit.outcome.debriefDate}}"
            >

          </div>


          <div class="sasha-outcome-field">

            <label for="debriefContact">
              Client Contact
            </label>

            <input
              id="debriefContact"
              name="debriefContact"
              type="text"
              value="{{pursuit.outcome.debriefContact}}"
              placeholder="Name or role of person providing feedback"
            >

          </div>


          <button
            class="sasha-outcome-save-button"
            type="button"
            id="saveClientDebrief"
          >
            Save Client Debrief
          </button>

        </section>

      </aside>

    </div>

  </div>

</section>


{{!-- =====================================================
     OUTCOME VIEW JAVASCRIPT
====================================================== --}}

<script>

document.addEventListener(
  'DOMContentLoaded',
  () => {

    const pursuitId =
      '{{pursuit._id}}';


    /* =====================================================
       ELEMENTS
    ====================================================== */

    const outcomeChatThread =
      document.getElementById(
        'outcomeChatThread'
      );

    const outcomeMessage =
      document.getElementById(
        'outcomeMessage'
      );

    const outcomeEvidenceFile =
      document.getElementById(
        'outcomeEvidenceFile'
      );

    const sendOutcomeMessage =
      document.getElementById(
        'sendOutcomeMessage'
      );

    const outcomeWorking =
      document.getElementById(
        'outcomeWorking'
      );

    const saveOutcomeResult =
      document.getElementById(
        'saveOutcomeResult'
      );

    const saveClientDebrief =
      document.getElementById(
        'saveClientDebrief'
      );

    const saveOutcomeDetails =
      document.getElementById(
        'saveOutcomeDetails'
      );


    /* =====================================================
       SMALL HELPERS
    ====================================================== */

    const setButtonState =
      (
        button,
        isWorking,
        workingText,
        normalText
      ) => {

        if (
          !button
        ) {
          return;
        }

        button.disabled =
          isWorking;

        button.textContent =
          isWorking
            ? workingText
            : normalText;

      };


    const showWorking =
      () => {

        if (
          outcomeWorking
        ) {

          outcomeWorking.hidden =
            false;

        }

      };


    const hideWorking =
      () => {

        if (
          outcomeWorking
        ) {

          outcomeWorking.hidden =
            true;

        }

      };


    const appendChatMessage =
      (
        role,
        content
      ) => {

        if (
          !outcomeChatThread ||
          !content
        ) {
          return;
        }


        const article =
          document.createElement(
            'article'
          );

        article.className =
          'sasha-chat-message ' +
          (
            role === 'user'
              ? 'is-user'
              : 'is-sasha'
          );


        const speaker =
          document.createElement(
            'div'
          );

        speaker.className =
          'sasha-chat-speaker';

        speaker.textContent =
          role === 'user'
            ? 'You'
            : 'Sasha';


        const bubble =
          document.createElement(
            'div'
          );

        bubble.className =
          'sasha-chat-bubble';

        bubble.textContent =
          content;


        article.appendChild(
          speaker
        );

        article.appendChild(
          bubble
        );

        outcomeChatThread.appendChild(
          article
        );


        outcomeChatThread.scrollTop =
          outcomeChatThread.scrollHeight;

      };


    /* =====================================================
       SEND MESSAGE TO SASHA
    ====================================================== */

    if (
      sendOutcomeMessage
    ) {

      sendOutcomeMessage.addEventListener(
        'click',
        async () => {

          const message =
            outcomeMessage
              ? outcomeMessage.value.trim()
              : '';

          const file =
            outcomeEvidenceFile &&
            outcomeEvidenceFile.files
              ? outcomeEvidenceFile.files[0]
              : null;


          if (
            !message &&
            !file
          ) {

            alert(
              'Add a message or debrief document first.'
            );

            return;

          }


          const formData =
            new FormData();

          formData.append(
            'pursuitId',
            pursuitId
          );

          formData.append(
            'message',
            message
          );


          if (
            file
          ) {

            formData.append(
              'outcomeEvidenceFile',
              file
            );

          }


          if (
            message
          ) {

            appendChatMessage(
              'user',
              message
            );

          }


          setButtonState(
            sendOutcomeMessage,
            true,
            'Sasha is working...',
            'Send to Sasha'
          );

          showWorking();


          try {

            const response =
              await fetch(
                '/outcome/chat',
                {
                  method: 'POST',
                  body: formData
                }
              );


            const data =
              await response.json();


            if (
              !response.ok
            ) {

              throw new Error(
                data.message ||
                data.error ||
                'Sasha could not process the outcome information.'
              );

            }


            const reply =
              data.reply ||
              data.message ||
              data.response ||
              data.assistantMessage ||
              'The outcome information has been reviewed.';


            appendChatMessage(
              'assistant',
              reply
            );


            if (
              outcomeMessage
            ) {

              outcomeMessage.value =
                '';

            }


            if (
              outcomeEvidenceFile
            ) {

              outcomeEvidenceFile.value =
                '';

            }


            /*
             * Reload when Sasha has updated structured
             * outcome information so the cards reflect
             * the saved record.
             */

            if (
              data.outcomeUpdated ||
              data.refresh
            ) {

              window.setTimeout(
                () => {
                  window.location.reload();
                },
                700
              );

            }

          } catch (
            error
          ) {

            console.error(
              'OUTCOME CHAT ERROR:',
              error
            );

            appendChatMessage(
              'assistant',
              'I could not process that outcome information. ' +
              'Please try again.'
            );

          } finally {

            hideWorking();

            setButtonState(
              sendOutcomeMessage,
              false,
              'Sasha is working...',
              'Send to Sasha'
            );

          }

        }
      );

    }


    /* =====================================================
       ENTER TO SEND
       SHIFT + ENTER CREATES NEW LINE
    ====================================================== */

    if (
      outcomeMessage
    ) {

      outcomeMessage.addEventListener(
        'keydown',
        event => {

          if (
            event.key === 'Enter' &&
            !event.shiftKey
          ) {

            event.preventDefault();

            if (
              sendOutcomeMessage
            ) {

              sendOutcomeMessage.click();

            }

          }

        }
      );

    }


    /* =====================================================
       SAVE RESULT
    ====================================================== */

    if (
      saveOutcomeResult
    ) {

      saveOutcomeResult.addEventListener(
        'click',
        async () => {

          const payload = {

            pursuitId,

            status:
              document.getElementById(
                'outcomeStatus'
              )?.value || 'pending',

            decisionDate:
              document.getElementById(
                'decisionDate'
              )?.value || null,

            successfulProponent:
              document.getElementById(
                'successfulProponent'
              )?.value.trim() || '',

            ourPrice:
              document.getElementById(
                'ourPrice'
              )?.value || null,

            winningPrice:
              document.getElementById(
                'winningPrice'
              )?.value || null

          };


          setButtonState(
            saveOutcomeResult,
            true,
            'Saving...',
            'Save Result'
          );


          try {

            const response =
              await fetch(
                '/outcome/result',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json'
                  },

                  body:
                    JSON.stringify(
                      payload
                    )
                }
              );


            const data =
              await response.json();


            if (
              !response.ok
            ) {

              throw new Error(
                data.message ||
                data.error ||
                'Could not save the proposal result.'
              );

            }


            window.location.reload();

          } catch (
            error
          ) {

            console.error(
              'SAVE OUTCOME RESULT ERROR:',
              error
            );

            alert(
              error.message
            );

          } finally {

            setButtonState(
              saveOutcomeResult,
              false,
              'Saving...',
              'Save Result'
            );

          }

        }
      );

    }


    /* =====================================================
       SAVE CLIENT DEBRIEF
    ====================================================== */

    if (
      saveClientDebrief
    ) {

      saveClientDebrief.addEventListener(
        'click',
        async () => {

          const payload = {

            pursuitId,

            clientDebrief:
              document.getElementById(
                'clientDebrief'
              )?.value.trim() || '',

            debriefDate:
              document.getElementById(
                'debriefDate'
              )?.value || null,

            debriefContact:
              document.getElementById(
                'debriefContact'
              )?.value.trim() || ''

          };


          setButtonState(
            saveClientDebrief,
            true,
            'Saving...',
            'Save Client Debrief'
          );


          try {

            const response =
              await fetch(
                '/outcome/debrief',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json'
                  },

                  body:
                    JSON.stringify(
                      payload
                    )
                }
              );


            const data =
              await response.json();


            if (
              !response.ok
            ) {

              throw new Error(
                data.message ||
                data.error ||
                'Could not save the client debrief.'
              );

            }


            setButtonState(
              saveClientDebrief,
              false,
              'Saving...',
              'Saved'
            );


            window.setTimeout(
              () => {

                setButtonState(
                  saveClientDebrief,
                  false,
                  'Saving...',
                  'Save Client Debrief'
                );

              },
              1500
            );

          } catch (
            error
          ) {

            console.error(
              'SAVE CLIENT DEBRIEF ERROR:',
              error
            );

            alert(
              error.message
            );

            setButtonState(
              saveClientDebrief,
              false,
              'Saving...',
              'Save Client Debrief'
            );

          }

        }
      );

    }


    /* =====================================================
       SAVE INTERNAL OBSERVATIONS + NOTES
    ====================================================== */

    if (
      saveOutcomeDetails
    ) {

      saveOutcomeDetails.addEventListener(
        'click',
        async () => {

          const payload = {

            pursuitId,

            internalObservations:
              document.getElementById(
                'internalObservations'
              )?.value.trim() || '',

            notes:
              document.getElementById(
                'outcomeNotes'
              )?.value.trim() || ''

          };


          setButtonState(
            saveOutcomeDetails,
            true,
            'Saving...',
            'Save Outcome Details'
          );


          try {

            const response =
              await fetch(
                '/outcome/details',
                {
                  method: 'POST',

                  headers: {
                    'Content-Type':
                      'application/json'
                  },

                  body:
                    JSON.stringify(
                      payload
                    )
                }
              );


            const data =
              await response.json();


            if (
              !response.ok
            ) {

              throw new Error(
                data.message ||
                data.error ||
                'Could not save the outcome details.'
              );

            }


            setButtonState(
              saveOutcomeDetails,
              false,
              'Saving...',
              'Saved'
            );


            window.setTimeout(
              () => {

                setButtonState(
                  saveOutcomeDetails,
                  false,
                  'Saving...',
                  'Save Outcome Details'
                );

              },
              1500
            );

          } catch (
            error
          ) {

            console.error(
              'SAVE OUTCOME DETAILS ERROR:',
              error
            );

            alert(
              error.message
            );

            setButtonState(
              saveOutcomeDetails,
              false,
              'Saving...',
              'Save Outcome Details'
            );

          }

        }
      );

    }


    /* =====================================================
       ADD EVALUATION CRITERION
    ====================================================== */

    const addEvaluationCriterion =
      document.getElementById(
        'addEvaluationCriterion'
      );


    if (
      addEvaluationCriterion
    ) {

      addEvaluationCriterion.addEventListener(
        'click',
        () => {

          if (
            outcomeMessage
          ) {

            outcomeMessage.value =
              'I want to add or update an evaluation criterion. ' +
              'Please help me record the criterion, our score, ' +
              'maximum score, winning score if known, and any ' +
              'client comments.';

            outcomeMessage.focus();

            outcomeMessage.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });

          }

        }
      );

    }


    /* =====================================================
       ADD LESSON
    ====================================================== */

    const addOutcomeLesson =
      document.getElementById(
        'addOutcomeLesson'
      );


    if (
      addOutcomeLesson
    ) {

      addOutcomeLesson.addEventListener(
        'click',
        () => {

          if (
            outcomeMessage
          ) {

            outcomeMessage.value =
              'I want to add a lesson from this pursuit. ' +
              'Help me describe what we learned, the evidence ' +
              'supporting it, and what we should do differently ' +
              'or repeat on future pursuits.';

            outcomeMessage.focus();

            outcomeMessage.scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });

          }

        }
      );

    }


  }
);

</script>