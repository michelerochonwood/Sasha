<section class="sasha-work-page sasha-outcome-page">

  <div class="sasha-work-container sasha-outcome-container">


    {{!-- =====================================================
         BACK TO PURSUIT
    ====================================================== --}}

    <div class="sasha-work-back">
      <a href="/pursuit/{{pursuit._id}}">
        ← Back to Pursuit
      </a>
    </div>


    {{!-- =====================================================
         PAGE HEADER
    ====================================================== --}}

    <header class="sasha-work-header">

      <div class="sasha-work-header-copy">

        <p class="sasha-work-eyebrow">
          Results &amp; Debrief
        </p>

        <h1>
          {{pursuit.proposalName}}
        </h1>

        <p class="sasha-work-client">
          {{pursuit.clientName}}

          {{#if pursuit.rfpNumber}}
            | {{pursuit.rfpNumber}}
          {{/if}}
        </p>

        <p class="sasha-work-introduction">
          Capture the final result, client feedback,
          evaluation scores and lessons from this pursuit.
          Sasha can help organize debrief information and
          identify evidence-backed patterns to carry forward.
        </p>

      </div>


      <div class="sasha-work-header-meta">

        <div class="sasha-work-meta-item">
          <span>Outcome</span>

          <strong class="sasha-outcome-capitalize">
            {{#if pursuit.outcome.status}}
              {{pursuit.outcome.status}}
            {{else}}
              Pending
            {{/if}}
          </strong>
        </div>


        <div class="sasha-work-meta-item">
          <span>Decision Date</span>

          <strong>
            {{#if pursuit.outcome.decisionDate}}
              {{pursuit.outcome.decisionDate}}
            {{else}}
              Not recorded
            {{/if}}
          </strong>
        </div>


        <div class="sasha-work-meta-item">
          <span>Submission</span>

          <strong>
            {{#if pursuit.submissionDeadline}}
              {{pursuit.submissionDeadline}}
            {{else}}
              Not recorded
            {{/if}}
          </strong>
        </div>

      </div>

    </header>


    {{!-- =====================================================
         OUTCOME SUMMARY
    ====================================================== --}}

    <section
      class="
        sasha-outcome-summary
        sasha-outcome-summary-{{pursuit.outcome.status}}
      "
    >

      <div class="sasha-outcome-summary-result">

        <span class="sasha-outcome-summary-label">
          Proposal Outcome
        </span>

        <strong>
          {{#if pursuit.outcome.status}}
            {{pursuit.outcome.status}}
          {{else}}
            Pending
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Successful Proponent
        </span>

        <strong>
          {{#if pursuit.outcome.successfulProponent}}
            {{pursuit.outcome.successfulProponent}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Our Price
        </span>

        <strong>
          {{#if pursuit.outcome.ourPrice}}
            ${{pursuit.outcome.ourPrice}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>


      <div class="sasha-outcome-summary-detail">

        <span>
          Winning Price
        </span>

        <strong>
          {{#if pursuit.outcome.winningPrice}}
            ${{pursuit.outcome.winningPrice}}
          {{else}}
            Not recorded
          {{/if}}
        </strong>

      </div>

    </section>


    {{!-- =====================================================
         MAIN WORKSPACE
    ====================================================== --}}

    <div class="sasha-outcome-layout">


      {{!-- ===================================================
           MAIN COLUMN
      ==================================================== --}}

      <main class="sasha-outcome-main">


        {{!-- =================================================
             SASHA CHAT
        ================================================== --}}

        <section class="sasha-chat-panel">

          <header class="sasha-chat-header">

            <div>

              <p class="sasha-work-eyebrow">
                Debrief Assistant
              </p>

              <h2>
                Talk through the result with Sasha
              </h2>

            </div>

            <span class="sasha-chat-status">
              Outcome
            </span>

          </header>


          <div
            class="sasha-chat-thread sasha-outcome-chat-thread"
            id="outcomeChatThread"
          >

{{#if pursuit.outcome.chatMessages.length}}

  {{#each pursuit.outcome.chatMessages}}

                <article
                  class="
                    sasha-chat-message
                    {{#if (eq role "user")}}
                      is-user
                    {{else}}
                      is-sasha
                    {{/if}}
                  "
                >

                  <div class="sasha-chat-speaker">

                    {{#if (eq role "user")}}
                      You
                    {{else}}
                      Sasha
                    {{/if}}

                  </div>

                  <div class="sasha-chat-bubble">
                    {{content}}
                  </div>

                </article>

              {{/each}}

            {{else}}

              <article class="sasha-chat-message is-sasha">

                <div class="sasha-chat-speaker">
                  Sasha
                </div>

                <div class="sasha-chat-bubble">
                  Tell me what happened with this pursuit.

                  You can paste client debrief notes,
                  evaluation scores, an award notice,
                  internal observations, or simply tell me
                  what you know.

                  I can help separate documented client
                  feedback from internal interpretation and
                  organize the useful findings for the
                  proposal record.
                </div>

              </article>

            {{/if}}

          </div>


          {{!-- =================================================
               SASHA WORKING VIDEO
          ================================================== --}}

          <div
            class="sasha-outcome-working"
            id="outcomeWorking"
            hidden
          >

            <video
              class="sasha-outcome-working-video"
              autoplay
              muted
              loop
              playsinline
            >
              <source
                src="/videos/sasha-working2.mp4"
                type="video/mp4"
              >
            </video>

            <p>
              Sasha is reviewing the outcome evidence...
            </p>

          </div>


          <div class="sasha-chat-composer">

            <label
              class="sasha-chat-label"
              for="outcomeMessage"
            >
              Message Sasha
            </label>

            <textarea
              id="outcomeMessage"
              name="message"
              placeholder="Paste debrief notes, scoring information, client feedback or tell Sasha what happened..."
            ></textarea>





            <div class="sasha-chat-actions">

              <p>
                Sasha will distinguish client evidence,
                evaluation data and internal observations
                before proposing updates to the outcome record.
              </p>

              <button
                class="sasha-chat-submit"
                type="button"
                id="sendOutcomeMessage"
              >
                Send to Sasha
              </button>

            </div>

          </div>

        </section>


 






      </main>



<aside class="sasha-outcome-sidebar">

  {{!-- ================================================
       FINAL SUBMITTED PROPOSAL
  ================================================= --}}

  <section class="sasha-outcome-card">

    <div class="sasha-outcome-card-heading">
      <p class="sasha-work-eyebrow">
        Submission Record
      </p>
      <h2>Final Submitted Proposal</h2>
    </div>

    <p class="sasha-outcome-guidance">
      Preserve the proposal exactly as submitted to
      the client, separately from Sasha's original draft.
    </p>

    {{#if pursuit.proposalDocuments.length}}

      <div class="sasha-outcome-final-proposal-list">

        {{#each pursuit.proposalDocuments}}

          <div class="sasha-outcome-final-proposal-item">

            <strong>
              {{#if title}}
                {{title}}
              {{else}}
                Final Proposal
              {{/if}}
            </strong>

            {{#if fileName}}
              <span>{{fileName}}</span>
            {{/if}}

            {{#if fileUrl}}
              <a
                class="sasha-outcome-final-proposal-link"
                href="{{fileUrl}}"
                target="_blank"
                rel="noopener noreferrer"
              >
                View Final Proposal
              </a>
            {{/if}}

          </div>

        {{/each}}

      </div>

    {{else}}

      <p class="sasha-outcome-empty">
        No final submitted proposal has been uploaded yet.
      </p>

    {{/if}}

<div class="sasha-outcome-field sasha-outcome-upload">
  <label for="finalProposalFile">
    Final Proposal PDF
  </label>
      <input
        id="finalProposalFile"
        type="file"
        accept=".pdf,application/pdf"
      >
    </div>

    <button
      class="sasha-outcome-save-button"
      type="button"
      id="uploadFinalProposal"
    >
      Upload Final Proposal
    </button>

  </section>


  {{!-- ================================================
       CLIENT DEBRIEF
  ================================================= --}}

  <section class="sasha-outcome-card">

    <div class="sasha-outcome-card-heading">
      <p class="sasha-work-eyebrow">
        Client Feedback
      </p>
      <h2>Client Debrief</h2>
    </div>

    <p class="sasha-outcome-guidance">
      Preserve client feedback, evaluation reports,
      and debrief documents for Sasha's analysis.
    </p>

    {{#each pursuit.outcome.documents}}

      {{#if (eq documentType "client_debrief")}}

        <div class="sasha-outcome-final-proposal-item">

          <strong>{{originalName}}</strong>

          <a
            href="/outcome/document/{{../../pursuit._id}}/{{_id}}"
            class="sasha-outcome-final-proposal-link"
          >
            Download Document
          </a>

        </div>

      {{/if}}

    {{/each}}

<div class="sasha-outcome-field sasha-outcome-upload">
  <label for="clientDebriefFile">
    Client Debrief Document
  </label>
      <input
        id="clientDebriefFile"
        type="file"
        accept=".pdf,.docx,.txt"
      >
    </div>

    <button
      class="sasha-outcome-save-button"
      type="button"
      id="uploadClientDebrief"
    >
      Upload Client Debrief
    </button>

  </section>


  {{!-- ================================================
       LESSONS LEARNED DOCUMENTS
  ================================================= --}}

  <section class="sasha-outcome-card">

    <div class="sasha-outcome-card-heading">
      <p class="sasha-work-eyebrow">
        Pursuit Knowledge
      </p>
      <h2>Lessons Learned Documents</h2>
    </div>

    <p class="sasha-outcome-guidance">
      Preserve the pursuit team's lessons learned
      for Sasha to analyze and reference.
    </p>

    {{#each pursuit.outcome.documents}}

      {{#if (eq documentType "lessons_learned")}}

        <div class="sasha-outcome-final-proposal-item">

          <strong>{{originalName}}</strong>

          <a
            href="/outcome/document/{{../../pursuit._id}}/{{_id}}"
            class="sasha-outcome-final-proposal-link"
          >
            Download Document
          </a>

        </div>

      {{/if}}

    {{/each}}

<div class="sasha-outcome-field sasha-outcome-upload">
  <label for="lessonsLearnedFile">
    Team Lessons Learned Document
  </label>
      <input
        id="lessonsLearnedFile"
        type="file"
        accept=".pdf,.docx,.txt"
      >
    </div>

    <button
      class="sasha-outcome-save-button"
      type="button"
      id="uploadLessonsLearned"
    >
      Upload Lessons Learned
    </button>

 </section>

</aside>

    </div>

  </div>

</section>







{{!-- =====================================================
     OUTCOME VIEW JAVASCRIPT
===================================================== --}}

<script>
document.addEventListener('DOMContentLoaded', () => {

  const pursuitId = '{{pursuit._id}}';
  const csrfToken = '{{csrfToken}}';

  const chatThread =
    document.getElementById('outcomeChatThread');

  const messageInput =
    document.getElementById('outcomeMessage');

  const evidenceInput =
    document.getElementById('outcomeEvidenceFile');

  const sendButton =
    document.getElementById('sendOutcomeMessage');

  const working =
    document.getElementById('outcomeWorking');

  /* =====================================================
     HELPERS
  ===================================================== */

  function setBusy(button, busy, normalText) {
    if (!button) return;

    button.disabled = busy;
    button.textContent = busy
      ? 'Working...'
      : normalText;
  }

  function appendMessage(role, content) {
    if (!chatThread || !content) return;

    const article = document.createElement('article');

    article.className =
      'sasha-chat-message ' +
      (role === 'user' ? 'is-user' : 'is-sasha');

    const speaker = document.createElement('div');
    speaker.className = 'sasha-chat-speaker';
    speaker.textContent =
      role === 'user' ? 'You' : 'Sasha';

    const bubble = document.createElement('div');
    bubble.className = 'sasha-chat-bubble';
    bubble.textContent = content;

    article.appendChild(speaker);
    article.appendChild(bubble);
    chatThread.appendChild(article);

    chatThread.scrollTop = chatThread.scrollHeight;
  }

  async function readResponse(response) {
    const data = await response.json();

    if (!response.ok || data.success === false) {
      throw new Error(
        data.error ||
        data.message ||
        'The request could not be completed.'
      );
    }

    return data;
  }

  /* =====================================================
     SHARED DOCUMENT UPLOAD
  ===================================================== */

  async function uploadDocument(
    inputId,
    buttonId,
    endpoint,
    normalText,
    pdfOnly = false
  ) {

    const input = document.getElementById(inputId);
    const button = document.getElementById(buttonId);

    if (!input || !button) return;

    const file = input.files?.[0];

    if (!file) {
      alert('Choose a document first.');
      return;
    }

    const allowedTypes = pdfOnly
      ? ['application/pdf']
      : [
          'application/pdf',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'text/plain'
        ];

    if (!allowedTypes.includes(file.type)) {
      alert(
        pdfOnly
          ? 'Please select a PDF.'
          : 'Please select a PDF, DOCX, or TXT file.'
      );
      return;
    }

    if (file.size > 25 * 1024 * 1024) {
      alert('The document must be 25 MB or smaller.');
      return;
    }

    const formData = new FormData();

    formData.append('pursuitId', pursuitId);
    formData.append('sourceDocuments', file);

    setBusy(button, true, normalText);

    try {

      const response = await fetch(endpoint, {
        method: 'POST',
        headers: {
          'x-csrf-token': csrfToken
        },
        body: formData
      });

      await readResponse(response);

      window.location.reload();

    } catch (error) {

      console.error('OUTCOME UPLOAD ERROR:', error);
      alert(error.message);

    } finally {

      setBusy(button, false, normalText);

    }
  }

  /* =====================================================
     DOCUMENT UPLOAD BUTTONS
  ===================================================== */

  const uploadFinalProposal =
    document.getElementById('uploadFinalProposal');

  if (uploadFinalProposal) {
    uploadFinalProposal.addEventListener('click', () => {
      uploadDocument(
        'finalProposalFile',
        'uploadFinalProposal',
        '/outcome/final-proposal',
        'Upload Final Proposal',
        true
      );
    });
  }

  const uploadClientDebrief =
    document.getElementById('uploadClientDebrief');

  if (uploadClientDebrief) {
    uploadClientDebrief.addEventListener('click', () => {
      uploadDocument(
        'clientDebriefFile',
        'uploadClientDebrief',
        '/outcome/client-debrief',
        'Upload Client Debrief'
      );
    });
  }

  const uploadLessonsLearned =
    document.getElementById('uploadLessonsLearned');

  if (uploadLessonsLearned) {
    uploadLessonsLearned.addEventListener('click', () => {
      uploadDocument(
        'lessonsLearnedFile',
        'uploadLessonsLearned',
        '/outcome/lessons-learned',
        'Upload Lessons Learned'
      );
    });
  }

  /* =====================================================
     SASHA OUTCOME CHAT
  ===================================================== */

  async function sendMessage() {

const message = messageInput?.value.trim() || '';

if (!message) {
  alert('Enter a message for Sasha.');
  return;
}

    const formData = new FormData();

    formData.append('pursuitId', pursuitId);
    formData.append('message', message);



    setBusy(sendButton, true, 'Send to Sasha');

    if (working) working.hidden = false;

    try {

      const response = await fetch('/outcome/chat', {
        method: 'POST',
        headers: {
          'x-csrf-token': csrfToken
        },
        body: formData
      });

      const data = await readResponse(response);

      if (message) {
        appendMessage('user', message);
      }

      appendMessage(
        'assistant',
        data.reply || 'Sasha has reviewed the information.'
      );

      if (messageInput) messageInput.value = '';
  

      if (data.outcomeUpdated || data.refresh) {
        window.setTimeout(() => {
          window.location.reload();
        }, 700);
      }

    } catch (error) {

      console.error('OUTCOME CHAT ERROR:', error);
      alert(error.message);

    } finally {

      if (working) working.hidden = true;
      setBusy(sendButton, false, 'Send to Sasha');

    }
  }

  if (sendButton) {
    sendButton.addEventListener('click', sendMessage);
  }

  if (messageInput) {
    messageInput.addEventListener('keydown', event => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();

        if (!sendButton?.disabled) {
          sendMessage();
        }
      }
    });
  }

});
</script>
