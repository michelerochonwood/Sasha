<section class="sasha-system-page">

  <div class="sasha-system-container">

    <p class="sasha-system-eyebrow">
      Error
    </p>

    <h1>
      Something Went Wrong
    </h1>

    <p>
      Sasha could not complete that request.
    </p>

    {{#if errorMessage}}

      <p>
        {{errorMessage}}
      </p>

    {{/if}}

    <a href="/">
      Return Home
    </a>

  </div>

</section>